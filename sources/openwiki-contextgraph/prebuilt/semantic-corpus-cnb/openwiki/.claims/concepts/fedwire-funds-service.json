    {
      "id": "claim_1663a7448be342f39238e2e5086209b4",
      "statement": "PPH's v2 lifecycle models the Fedwire leg as RELEASED -> SENT_TO_NETWORK -> NETWORK_ACCEPTED (on Fed pacs.002 positive ack) or NETWORK_REJECTED (admi.002/negative pacs.002), then COMPLETED, with possible later transition to RETURNED on a pacs.004.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L54-L83",
