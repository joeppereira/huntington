    {
      "id": "claim_27ae8bdc35fc4793a79cdfddb57d76c5",
      "statement": "OMAD (Output Message Accountability Data) is assigned by the Federal Reserve and returned in the pacs.002 acknowledgment for each accepted value message, together with a Fed creation timestamp; the Fedwire Funds Connector publishes this acknowledgment to the net.fedwire.ack.v1 Kafka topic.",
      "evidence": [
        {
          "resource": "repo://sources/estate/png-tdd-6.0-payment-network-gateway-fedwire-and-gpi-technical-design.md#L40-L42",
          "version": "repo-lines-v1:sha256:3467d3152bab3b5f0dd073ec1a83cab4e83a170214f2053a1f65d147fe529852:"
        }
      ]
    },
    {
      "id": "claim_724673d033124765a3222daddf680d83",
      "statement": "OMAD is available only via net.fedwire.ack.v1 and the v2 REST field identifiers.omad; the legacy v1 API's fedRef field carries IMAD only, and OMAD (and UETR) are not available in v1 at all.",
