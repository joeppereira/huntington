  "claims": [
    {
      "id": "claim_558d590722c54a399074ca1882ebaa76",
      "statement": "POL-FCC-014 §4 defines four client-disclosure tiers for payment holds: P (public status, factual processing status/timing), C (client-actionable, approved explanation plus a permitted client action), G (generic review, generic 'being reviewed' message only), and R (restricted, generic 'being reviewed' message identical to tier G).",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L44-L51",
          "version": "repo-lines-v1:sha256:de2e7d7895beb0c76c9802ac5bb4352c754a6f20c1ab7ecb7e0e495f64ead307:"
        }
      ]
    },
    {
      "id": "claim_6b799e27d591463aa9bd59637eff09ba",
      "statement": "POL-FCC-014 §5.1(2) requires that tier R and tier G holds be presented identically to the client - same label, icon, color, copy, actions, and absence of timing information - so the client cannot infer the nature of the review.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L65-L69",
          "version": "repo-lines-v1:sha256:6c90ea864869597b396b4ae0cbe0b66de068c88b370647a02817146980d8ec43:"
        }
      ]
    },
    {
      "id": "claim_18c5556d65484e7681d1c817b3cdcffd",
      "statement": "PRSP-HMS-3.4 defines twelve Hold Reason Codes (HRC-01 through HRC-12) each with a mnemonic, description, disclosure tier, and observed share of total holds, ranging from HRC-01 DUP_SUSPECT (tier C, 22%) to HRC-11 LEGAL_HOLD (tier R, <0.5%) and HRC-12 OPS_MANUAL_REVIEW (tier G, 1.5%).",
      "evidence": [
        {
          "resource": "repo://sources/estate/prsp-hms-3.4-hold-management-service-design-and-reason-taxonomy-restricted.md#L44-L68",
          "version": "repo-lines-v1:sha256:4b07a7e501fddd4251a2eda6d3652578e28d7e44772e2cd8b759406bc066484d:"
        }
      ]
    },
    {
      "id": "claim_efdef1c2ce734292b81697cda7738709",
      "statement": "POL-FCC-014 Appendix A maps each HRC code to an approved client-facing copy key and the client action (if any) permitted for that code; all tier-R codes (HRC-07 through HRC-11) and the tier-G code HRC-12 share the same generic copy key COPY-HOLD-GEN-01 with no permitted client action, while tier-C/P codes (HRC-01 through HRC-06) have distinct copy keys and specific permitted actions.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L106-L131",
          "version": "repo-lines-v1:sha256:8beeaf78f5dccd7fe281ff8fbecb429514a021fcd0cf605a3bb3de4ec2ebd31c:"
        }
      ]
    },
    {
      "id": "claim_b2fcbc412d0b4f7c91cf34fe01289ead",
      "statement": "POL-FCC-014 §5.1(1) and Appendix C prohibit displaying, transmitting or implying restricted hold reasons, hold codes, scores, list names, match details, analyst notes or queue names in any client-facing channel, and bar specific terms (e.g., fraud, suspicious, sanctions, OFAC, watch list, AML, investigation, risk score, law enforcement, blocked) from client-facing copy regardless of tier.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L145-L147",
