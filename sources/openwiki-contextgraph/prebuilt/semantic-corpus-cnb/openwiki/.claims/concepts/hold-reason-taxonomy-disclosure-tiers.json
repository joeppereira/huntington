    {
      "id": "claim_d7a8eb1544f246118c735f1b0b78cbac",
      "statement": "HMS Hold `description` and `analystNotes` fields are classified Restricted and are auto-generated from rule templates that embed HRC mnemonics and investigative detail (e.g., fraud scores, sanctions match scores and review levels); the risk.hold.events.v1 topic carrying this data is restricted to FCT and Payment Operations tooling and channel applications are not authorized consumers.",
      "evidence": [
        {
          "resource": "repo://sources/estate/prsp-hms-3.4-hold-management-service-design-and-reason-taxonomy-restricted.md#L74-L78",
