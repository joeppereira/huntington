  "claims": [
    {
      "id": "claim_674db204406044acbe219b1f4704f7dd",
      "statement": "PPH's v2 lifecycle state COMPLETED represents the internal accounting close of a wire, occurring at end of day after RELEASED, SENT_TO_NETWORK, and NETWORK_ACCEPTED have already occurred.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L54-L83",
          "version": "repo-lines-v1:sha256:fe959f59a4c9193850c9329f96b0e9b0dee89db60bf681e8209d7555f9c5042c:"
        }
      ]
    },
    {
      "id": "claim_c3cbb7ef0fd54715a5cc01a4b4b7f84a",
      "statement": "The legacy PPH v1 status API collapses the four distinct v2 states RELEASED, SENT_TO_NETWORK, NETWORK_ACCEPTED, and COMPLETED into a single consumer-facing value, PROCESSED, so v1 consumers cannot distinguish a merely-released wire from one acknowledged by the network or accounting-closed.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L76-L86",
          "version": "repo-lines-v1:sha256:b80659f5240008cd2708b7f999f0b7e470051f1ccaf13998907be58566090da8:"
        }
      ]
    },
    {
      "id": "claim_cb5e3994ec914825a2ccdb0c4dfa84ed",
      "statement": "NETWORK_ACCEPTED has rail-specific finality: for Fedwire it means final, irrevocable interbank settlement (Regulation J / UCC Article 4A) via a pacs.002 acknowledgment carrying an OMAD, but does not confirm beneficiary credit; for Swift CBPR+ it means only that the message was accepted by the Swift network for delivery to the next agent, with no settlement implication, and beneficiary credit is known only from gpi ACCC if reported.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L88-L95",
          "version": "repo-lines-v1:sha256:0e075ddaf74fe14ef25d7654439b547f620a93a40fb689563c40fbfb4f7605d8:"
        }
      ]
    },
    {
      "id": "claim_f1c378da4f60458dad4e0db4a598011e",
      "statement": "POL-FCC-014 Section 5.2 permits the client-facing terms 'Completed' or 'Settled' only when Fedwire acceptance has been received (domestic) or gpi ACCC has been received from the beneficiary bank (international), and explicitly prohibits these terms on release, transmission, Swift network ACK, or ACSP statuses.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L77-L84",
          "version": "repo-lines-v1:sha256:572d332a69845cc81094d446042a13b722fb64cc20c483444837217b87c12891:"
        }
      ]
    },
    {
      "id": "claim_6c38eeec6a8b440294471483f6384356",
      "statement": "POL-FCC-014 permits the term 'Credited to beneficiary' only on gpi ACCC, and states that domestic Fedwire does not report beneficiary credit at all, meaning no domestic equivalent of a beneficiary-credit confirmation exists.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L83-L84",
