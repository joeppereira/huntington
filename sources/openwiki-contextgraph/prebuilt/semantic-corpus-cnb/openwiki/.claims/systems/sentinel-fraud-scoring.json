    {
      "id": "claim_5b39ec6f9de44ac78f306d2caec3d654",
      "statement": "MRM-POL-02 imposes an absolute prohibition on using Tier 1 financial-crimes model outputs for product, marketing, or client-facing purposes, explicitly naming Sentinel fraud scores (M-FCT-0021); the prohibition is not conditioned on consent, anonymization, or aggregation and extends to the model's registered inputs/features as well as its raw outputs.",
      "evidence": [
        {
          "resource": "repo://sources/estate/mrm-pol-02-v7.0-model-risk-management-policy-extract.md#L44-L46",
