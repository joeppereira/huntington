    {
      "id": "claim_465e945926a24bb0ae8b97577ded8385",
      "statement": "Because Sentinel is a vendor model, MRM-POL-02's vendor-model provision applies: where the vendor cannot provide sufficient information about internals, compensating controls and outcome monitoring are required as a substitute for full-transparency validation evidence.",
      "evidence": [
