        }
      ]
    },
    {
      "id": "claim_7c10abce81924bc7bdce21786aa83a07",
      "statement": "SPS's wire-support gap is characterized in both the architecture documentation and the Jira backlog as an unscheduled configuration gap rather than an architectural limitation: CBO-ARCH-WC-4.1 lists it as a reusable asset with a known extension path, and no Jira story in the current backlog snapshot is actively requesting the pay.wire.lifecycle.v2 ACL or building the wire mapping module.",
      "evidence": [
        {
          "resource": "repo://sources/estate/cbo-arch-wc-4.1-wire-center-current-state-architecture.md#L143-L152",
