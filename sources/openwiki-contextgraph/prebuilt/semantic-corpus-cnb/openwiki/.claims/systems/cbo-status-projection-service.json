    {
      "id": "claim_e767f04509d84e9694203102fd5772f5",
      "statement": "ADR-PAY-019, which SPS implements, was adopted after the Wire Status Lite pilot (CBO-3120) caused INC-2024-1182 by polling PPH's synchronous status API at ~85 TPS and exhausting its thread pool, delaying wire release for 47 minutes; this incident is the direct origin of SPS's event-driven, no-polling design.",
      "evidence": [
        {
          "resource": "repo://sources/estate/arb-pay-reg-2026q3-payments-arb-adr-register-and-minutes.md#L34-L36",
          "version": "repo-lines-v1:sha256:1f35aa53be2f9b72dd8b1c998aa1932b987c28459a606949eef4cce03bb1b7c2:"
        },
        {
