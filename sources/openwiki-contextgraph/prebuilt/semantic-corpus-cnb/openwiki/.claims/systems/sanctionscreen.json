    {
      "id": "claim_5621e6e4a35b4a41b8f5c1764bf336ad",
      "statement": "PRISM Payments Hub (PPH) performs a synchronous call to PRSP (SanctionScreen and Sentinel) during its Screening processing stage; this stage has a typical duration of 1-20 seconds in PPH's canonical SCREENING lifecycle state, and a hit causes HMS to create a hold while PPH transitions the payment to HELD.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L108-L110",
