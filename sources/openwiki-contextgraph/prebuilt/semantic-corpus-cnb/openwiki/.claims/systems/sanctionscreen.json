    {
      "id": "claim_e6a2736ad6884c598524629aff793020",
      "statement": "A SanctionScreen potential match is the sole upstream source of hold-reason code HRC-09 (SANCTIONS_REVIEW), tier R, pending L1/L2 Sanctions Operations analyst review, accounting for about 7% of HMS holds by volume with a median time to disposition of roughly 3 hours 20 minutes.",
      "evidence": [
        {
          "resource": "repo://sources/estate/prsp-hms-3.4-hold-management-service-design-and-reason-taxonomy-restricted.md#L44-L54",
          "version": "repo-lines-v1:sha256:a0ca4391206df31d5ec9160da8321bb87d54342f69b6b3cb763b351e29478834:"
        },
