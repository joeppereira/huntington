    {
      "id": "claim_743d17eef32c4d85b84ed056b3ebbc12",
      "statement": "Since the Federal Reserve's single-day ISO 20022 cutover on 2025-07-14 (which retired the legacy FAIM format entirely), FFC exchanges only ISO 20022 messages with the Fed: outbound pacs.008, pacs.009, pacs.004, camt.056, camt.110, and inbound pacs.008/pacs.009/pacs.004, pacs.002, and admi.002.",
      "evidence": [
        {
          "resource": "repo://sources/estate/png-tdd-6.0-payment-network-gateway-fedwire-and-gpi-technical-design.md#L32-L38",
          "version": "repo-lines-v1:sha256:2d72276b03a208435165e1c10df272363fd71779b364586d50074553104b10cd:"
        }
      ]
    },
    {
      "id": "claim_7306b5feb698482dbdc5c7d63bab437a",
      "statement": "For every accepted outbound value message, the Federal Reserve returns a pacs.002 carrying the OMAD and a Fed creation timestamp, which FFC publishes to net.fedwire.ack.v1 (EV-PNG-01); errors (admi.002, negative pacs.002) are published on the same topic keyed by IMAD since a rejected message has no OMAD.",
      "evidence": [
        {
          "resource": "repo://sources/estate/png-tdd-6.0-payment-network-gateway-fedwire-and-gpi-technical-design.md#L40-L43",
          "version": "repo-lines-v1:sha256:db7b2972b8e12919bfe41f413e939fba226215607b0eb018fc75713089861747:"
        }
      ]
    },
    {
      "id": "claim_482fea24dce14f2eb9989d3d4b2aa5ce",
      "statement": "Acceptance by the Fedwire Funds Service constitutes final and irrevocable settlement between sending and receiving banks under Regulation J; the Federal Reserve does not report, and the pacs.002 does not confirm, that the receiving bank has credited the beneficiary's account.",
      "evidence": [
        {
          "resource": "repo://sources/estate/png-tdd-6.0-payment-network-gateway-fedwire-and-gpi-technical-design.md#L42-L43",
