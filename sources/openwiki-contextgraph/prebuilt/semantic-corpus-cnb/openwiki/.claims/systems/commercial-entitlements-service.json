    {
      "id": "claim_d9f8b397e5b949c1860a599ba7501df2",
      "statement": "cbo-wire-bff calls CES synchronously at request time via GET /ces/v2/users/{id}/entitlements (EP-CES-01) for authorization and account-level filtering, alongside its other per-request dependencies: PPH v1 wire APIs, POST /cbo/auth/v2/step-up, and POST /ens/v3/notifications.",
      "evidence": [
        {
          "resource": "repo://sources/estate/cbo-arch-wc-4.1-wire-center-current-state-architecture.md#L39-L66",
          "version": "repo-lines-v1:sha256:2fe963bd5eb347c33c20710163f464c0051eb92e5c869283da2baac323ee81f9:"
        }
      ]
    },
    {
      "id": "claim_8c7477739a8d496ab7d2fa759b42f7db",
      "statement": "cbo-wire-bff authorizes Wire Center actions against five CES entitlement types (WIRE_VIEW, WIRE_INITIATE, WIRE_APPROVE, WIRE_RELEASE, WIRE_TEMPLATE_ADMIN), and wire release additionally and independently requires step-up authentication plus client-configured dual approval above client thresholds.",
      "evidence": [
        {
          "resource": "repo://sources/estate/cbo-arch-wc-4.1-wire-center-current-state-architecture.md#L115-L123",
