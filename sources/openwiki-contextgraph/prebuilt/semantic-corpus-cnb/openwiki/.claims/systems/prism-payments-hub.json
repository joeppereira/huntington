          "version": "repo-lines-v1:sha256:26dc3bcb85621115c2550a8eb6e5ee53bc37a2d405e0a548157a4ccddfaee35f:"
        }
      ]
    },
    {
      "id": "claim_e01d24d10d62499484332a30eb6a3588",
      "statement": "PPH publishes payment lifecycle events on the pay.wire.lifecycle.v2 Kafka topic (EV-PPH-01, WireLifecycleEvent v2.3 Avro, 7-day retention, Confidential-Client classification, consumer ACL via PPH Jira taking ~3 weeks) and ACH events on pay.ach.lifecycle.v1 (EV-PPH-02); ISO pacs.004 return reason codes (e.g., AC04, AC01, RR05) have been published on pay.wire.lifecycle.v2 since 2026-08 per PPH-2266.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-api-cat-2026.3-prism-payments-hub-api-and-event-catalog.md#L106-L115",
          "version": "repo-lines-v1:sha256:af80132e90803c86c77f75d5b8602dc1909e9c680bc61de738886db890e17c08:"
        }
