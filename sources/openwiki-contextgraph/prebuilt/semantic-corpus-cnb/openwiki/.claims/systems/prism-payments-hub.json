    {
      "id": "claim_82bae1d47d8c4981b32a61f216d3f456",
      "statement": "PPH enforces fixed cutoffs and operating windows: a Fedwire operating day of 9:00 p.m. ET (prior day) to 7:00 p.m. ET, a Fedwire third-party customer transfer cutoff of 6:00 p.m. ET (HRC-04 warehousing after), a CBO same-day domestic wire cutoff of 5:30 p.m. ET, and currency-specific international cutoffs (e.g., EUR 2:00 p.m. ET, GBP 1:00 p.m. ET, MXN 3:00 p.m. ET, JPY prior day).",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L112-L130",
          "version": "repo-lines-v1:sha256:313a794a684c6b16b3c648d664ae13b0c77c80583fa16094e3f2081003670f01:"
        }
      ]
    },
    {
      "id": "claim_308f76a26f2642708d95f3b26dbbc30e",
      "statement": "PPH's v1 API (EP-PPH-01/02/03) is rate-limited to 20 TPS shared across all consumers on the status endpoint, caps list results at 500 rows with no cursor, and its status field is a coarse seven-value enum (RECEIVED | PENDING | HELD | PROCESSED | REJECTED | CANCELLED | RETURNED) with fedRef carrying IMAD only (null for Swift wires).",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-api-cat-2026.3-prism-payments-hub-api-and-event-catalog.md#L37-L65",
          "version": "repo-lines-v1:sha256:63d5fbcecf7b16ed5e77dc26410e8026f57610dff82c89cbc05a4ed869b125b2:"
        }
      ]
    },
    {
      "id": "claim_a921f7a8345a4bf991a65debc4cfde92",
      "statement": "PPH's v2 API reached GA in 2025-10 and comprises EP-PPH-04 (payment detail, 150 TPS, returns lifecycleState/identifiers/network/hold/charges but no settlement object), EP-PPH-05 (search, filterable by clientId but not account, no beneficiary-name filter per backlog item PPH-2251), EP-PPH-06 (state history, PPH-processing-time timestamps), and EP-PPH-07 (submission, requiring an Idempotency-Key header); a proposed v2 settlement object exposing fedSettlementTs and rail-aware settlementStatus is tracked as backlog item PPH-2207 with no product sponsor.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-api-cat-2026.3-prism-payments-hub-api-and-event-catalog.md#L125-L131",
          "version": "repo-lines-v1:sha256:1f58cdd4769edb8f2350ba1a4beffd7e8cae8506bea0656f3294c1a7a95b051c:"
        },
        {
