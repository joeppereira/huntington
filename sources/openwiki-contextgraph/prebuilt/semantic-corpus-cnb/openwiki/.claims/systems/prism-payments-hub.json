    {
      "id": "claim_c26ada9f21564bab813172085220baa9",
      "statement": "PPH service levels differ by interface: v1 REST offers 99.9% availability and 350ms p95 latency with best-effort support until sunset; v2 REST offers 99.95% availability and 180ms p95 latency with T1 support; pay.wire.lifecycle.v2 offers 99.95% availability with sub-2-second p95 event lag and T1 support.",
      "evidence": [
