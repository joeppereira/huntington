  "claims": [
    {
      "id": "claim_ed83d573a1cb43c5bd8ed1ae0e89c056",
      "statement": "PRISM Payments Hub (PPH) is CNB's wire orchestration platform built on the vendor Volaris Payment Platform 9.4, operated on-premises in an active-active configuration across the Columbus and Charlotte data centers, with a 99.95% availability target during Fedwire operating hours.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L26-L36",
          "version": "repo-lines-v1:sha256:ff5b8c1135a39af1fe9661e890dd8ad49eb73d3180dde2b0d0cdbf568f78f42b:"
        }
      ]
    },
    {
      "id": "claim_e0589dc5114a43cc87f795356292d03e",
      "statement": "PPH processes a payment through seven stages: Intake, Validation & enrichment, Screening (synchronous PRSP call creating an HMS hold and HELD state on a hit), Funds control (CDP memo debit, HRC-05 holds with auto-retry until 5:30pm ET), Release (UETR assignment and pacs.008/pacs.009 message build), Network (delivery to Fedwire Funds Connector or Swift Alliance/gpi Connector), and Close (COMPLETED, later RETURNED on pacs.004).",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L38-L52",
          "version": "repo-lines-v1:sha256:3f639c914bd212446bd1d2c5d4313d61e968875b18c65594496368e5e87c7aa7:"
        }
      ]
    },
    {
      "id": "claim_75c6fdf389474130a4b1732689ff079a",
      "statement": "PPH's v2 lifecycle defines ten canonical states (RECEIVED, VALIDATING, SCREENING, HELD, REPAIR, FUNDS_CONTROL, WAREHOUSED, RELEASED, SENT_TO_NETWORK, NETWORK_ACCEPTED, NETWORK_REJECTED, COMPLETED, CANCELLED, RETURNED), and the legacy v1 status field collapses RELEASED, SENT_TO_NETWORK, NETWORK_ACCEPTED, and COMPLETED into a single PROCESSED value, so v1 consumers cannot distinguish release from network acknowledgment from accounting close.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L54-L86",
          "version": "repo-lines-v1:sha256:bde107894ff96b385e7ce3462c846a6a6c16cc21f3e0a22fa2e5c8c6d84c8dbf:"
        }
      ]
    },
    {
      "id": "claim_5e2e4af7206141fea26962a35cf58284",
      "statement": "The NETWORK_ACCEPTED state has rail-specific meaning: for Fedwire Funds it is a Federal Reserve pacs.002 positive acknowledgment carrying OMAD representing final, irrevocable interbank settlement (not beneficiary credit); for Swift CBPR+ it is only a SwiftNet delivery ACK for pacs.008 with no settlement implication, and the v2 stateHistory timestamp for NETWORK_ACCEPTED reflects PPH's processing time rather than the Federal Reserve's pacs.002 creation timestamp.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L88-L95",
          "version": "repo-lines-v1:sha256:0e075ddaf74fe14ef25d7654439b547f620a93a40fb689563c40fbfb4f7605d8:"
        }
      ]
    },
    {
      "id": "claim_c0531002b5644950b2188364ff66fd89",
      "statement": "PPH assigns and tracks six identifier types with distinct owners and scopes: pphId (PPH, internal key), cboRef (CBO, channel reference), IMAD (PPH as Fedwire sender, input message), OMAD (Federal Reserve, output message acceptance), UETR (PPH at release, end-to-end tracking), and EndToEndId (originator/PPH passthrough), with OMAD and UETR unavailable in the v1 API.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-api-cat-2026.3-prism-payments-hub-api-and-event-catalog.md#L61-L65",
          "version": "repo-lines-v1:sha256:d4501b71b5b2ea48a7d8ba67b23dba2212f30b0cee810786d5ee39e203037bb5:"
        },
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L97-L106",
          "version": "repo-lines-v1:sha256:ea23ef2c4f42c936de062beca162eac894af0795b48f20c49f8f94b6a6e64f84:"
        }
      ]
    },
    {
      "id": "claim_6e7bdf0cf5d144069fcb1daa5c585847",
      "statement": "When PRSP/HMS raises a hold during screening or funds control, PPH transitions the payment to HELD using the returned holdId; since a 2019 integration PPH also synchronizes the HMS hold description into the legacy v1 holdReasonDesc field (uncurated free text) for the Wire Room console, while the v2 API exposes only hold.isHeld and hold.holdId per ADR-PAY-021, and hold reasons are not published on any PPH Kafka topic.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-api-cat-2026.3-prism-payments-hub-api-and-event-catalog.md#L115-L115",
          "version": "repo-lines-v1:sha256:0f46a3b66150121475fa5f38ac89a8828fc0b90394fadfb4197d7b642198cdf3:"
