    {
      "id": "claim_0105f8c43e9044b6b09c86dad4bc16ce",
      "statement": "GPI-C performs the gpi Tracker integration as a fixed-schedule batch pull every 4 hours (00:00, 04:00, 08:00, 12:00, 16:00, 20:00 ET), requesting changed transactions for outbound UETRs from the last 30 days and upserting results keyed by UETR into the Oracle table GPI_TRACKER_SNAPSHOT, which feeds Payment Operations' Investigations Workbench and the TDIP nightly load; there is no internal API for gpi status and the snapshot must not be exposed directly to client channels.",
      "evidence": [
        {
          "resource": "repo://sources/estate/png-tdd-6.0-payment-network-gateway-fedwire-and-gpi-technical-design.md#L75-L89",
          "version": "repo-lines-v1:sha256:a92aeabe5cb4f06f589fd8100fa90e08231f361e001bc9c68a6bdef1db1bc968:"
        }
      ]
    },
    {
      "id": "claim_a948ef6f67e64d3e96e04876b26cd249",
      "statement": "The Swift Tracker API contract permits 250,000 calls per month (renewal 2027-01-31); batch pulls plus Ops ad-hoc lookups already used ~61% of quota, while client-channel per-payment lookups were estimated at ~1.9 million calls/month (~7x the quota), so any real-time gpi design must use a change-feed with internal fan-out rather than per-payment Swift calls.",
      "evidence": [
        {
          "resource": "repo://sources/estate/png-tdd-6.0-payment-network-gateway-fedwire-and-gpi-technical-design.md#L90-L92",
          "version": "repo-lines-v1:sha256:418fb701c113b34af833ad1f207a2f37a37d75a14e8f2160bc6ddae8643bdf49:"
        }
      ]
    },
    {
