  "claims": [
    {
      "id": "claim_9310dc744b944688a17bcfaa4ea9a972",
      "statement": "HMS is the system of record for holds placed on outbound payments by screening, fraud, funds control and operational controls, and is part of the Payment Risk & Screening Platform (PRSP) together with Sentinel Fraud Scoring (vendor model, MRM ID M-FCT-0021) and SanctionScreen; HMS work queues are surfaced to Payment Operations and the FIU via the Investigations Workbench (IWB).",
      "evidence": [
        {
          "resource": "repo://sources/estate/prsp-hms-3.4-hold-management-service-design-and-reason-taxonomy-restricted.md#L24-L26",
          "version": "repo-lines-v1:sha256:f6fb690120df161b152daf802cd9a5d75abcf329a7d1f3edc5375f7506369281:"
        }
      ]
    },
    {
      "id": "claim_9e3ed95cbc404c5f84ac585a6142953e",
      "statement": "A hold progresses through the states OPEN, IN_REVIEW, ESCALATED, and terminates in exactly one of RELEASED, REJECTED, BLOCKED, or EXPIRED; BLOCKED holds move funds to a blocked account and must be reported to OFAC within 10 business days under 31 CFR 501.603, and EXPIRED is an auto-cancel after the client response window for HRC-01/02/05.",
      "evidence": [
        {
          "resource": "repo://sources/estate/prsp-hms-3.4-hold-management-service-design-and-reason-taxonomy-restricted.md#L28-L38",
          "version": "repo-lines-v1:sha256:3289fc66d676d11e5fff1066c372a6656b4e757edd15a85e02a56238b140704d:"
        }
      ]
    },
    {
      "id": "claim_4b39294c93214d04bf75ac0df3d25cad",
      "statement": "HMS classifies every hold against a twelve-entry Hold Reason Code (HRC-01 through HRC-12) taxonomy, each with a mnemonic, description, POL-FCC-014 disclosure tier (P/C/G/R) and observed share of hold volume; overall volume is roughly 410 holds/business day (~2.6% of outbound wires) with documented median time-to-disposition per code.",
      "evidence": [
        {
          "resource": "repo://sources/estate/prsp-hms-3.4-hold-management-service-design-and-reason-taxonomy-restricted.md#L40-L70",
          "version": "repo-lines-v1:sha256:2435d22f12d7f8f110f3b51d97e0f99f6711a890af6c8e06f670364d3fb49414:"
        }
      ]
    },
    {
      "id": "claim_32a41f62fd9f4cd1a9c7a880e331869c",
      "statement": "Tier-R HRC codes (HRC-07 FRAUD_MODEL_HIGH, HRC-08 ATO_SUSPECT, HRC-09 SANCTIONS_REVIEW, HRC-10 AML_REVIEW, HRC-11 LEGAL_HOLD) must be presented to clients identically to tier-G HRC-12 (OPS_MANUAL_REVIEW) - same label, icon, color, copy, actions and absence of timing information - so a client cannot infer the nature of a review from the presentation.",
      "evidence": [
        {
          "resource": "repo://sources/estate/prsp-hms-3.4-hold-management-service-design-and-reason-taxonomy-restricted.md#L40-L68",
          "version": "repo-lines-v1:sha256:95994f4b2ec5fe0fe6be45d147c50e2ee5bbeb69c461f0b31cdeef665eb58d0b:"
        }
      ]
    },
    {
      "id": "claim_841b6e61901547fdbcb74fab1018c06f",
      "statement": "HMS hold description and analystNotes fields are classified Restricted and are generated from rule templates that typically embed the HRC mnemonic and investigative context (e.g. 'FRAUD_MODEL_HIGH sc=9xx L1 queue', 'SANCTIONS_REVIEW name match 0.91 L2'); the risk.hold.events.v1 topic carrying this detail is restricted to FCT and Payment Operations tooling and channel applications are not authorized consumers.",
      "evidence": [
        {
          "resource": "repo://sources/estate/prsp-hms-3.4-hold-management-service-design-and-reason-taxonomy-restricted.md#L72-L78",
          "version": "repo-lines-v1:sha256:417834ca8b8dea07e395042dee88b5845b075b2b18891a5ae4c83821b5f2d613:"
        }
      ]
    },
    {
      "id": "claim_514d65cde5f040ccbf60fb4046b015fd",
      "statement": "Since 2019, HMS has synchronized its free-text hold description into legacy PPH v1's holdReasonDesc field for Wire Room console backward compatibility; this sync predates ADR-PAY-021 (2025-04-08) and remains an active, time-boxed exception until the PPH v1 sunset, tracked as open risk FCT-2004.",
      "evidence": [
