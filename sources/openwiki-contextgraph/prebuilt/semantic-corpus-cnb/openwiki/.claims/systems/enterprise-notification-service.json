  "claims": [
    {
      "id": "claim_2eb8d99933be406ea49599fbd7dbd37a",
      "statement": "ENS is a shared, multi-tenant notification platform delivering transactional notifications across email, SMS, mobile push (CBO Mobile), and the CBO in-app inbox; producers emit a registered event type, and ENS resolves recipients from subscriptions, renders an approved template, and delivers per the user's channel preference.",
      "evidence": [
        {
          "resource": "repo://sources/estate/ens-int-3.2-enterprise-notification-service-integration-guide.md#L24-L26",
          "version": "repo-lines-v1:sha256:bd0fbd92da89beceb0b9d79e156a4cc10ac96ea3ca2612936687f743c466449f:"
        }
      ]
    },
    {
      "id": "claim_cd1bdd98f8c248e29993797adfcf5e9f",
      "statement": "ENS enforces platform throughput of 300 msgs/s sustained / 1,200 msgs/s burst, with the Treasury (TRS) domain capped at a 120 msgs/s quota, a 4s p95 delivery latency target for push/in-app, account-number masking to last 4 digits, and a prohibition on Restricted data in any payload or template; SMS additionally requires a TCPA consent flag and is limited to 160-character templates.",
      "evidence": [
        {
          "resource": "repo://sources/estate/ens-int-3.2-enterprise-notification-service-integration-guide.md#L28-L33",
          "version": "repo-lines-v1:sha256:54e97e2a4f8b51d9b34f2192cd432f58755b9128e08dd2253dbc60704ae0481b:"
        }
      ]
    },
    {
      "id": "claim_1264b32fbd144cd1a27554113ccdabb9",
      "statement": "Onboarding a new ENS event type is a fixed five-step process (ServiceNow catalog submission, payload/recipient-resolution design, per-channel template drafting with bi-weekly Disclosure Review Committee review, ENS configuration and test at ~12 engineering hours, and producer UAT/production enablement) with a published 6-week SLA from complete submission to production; requests submitted after 2026-11-20 are scheduled after the year-end change freeze.",
      "evidence": [
        {
          "resource": "repo://sources/estate/ens-int-3.2-enterprise-notification-service-integration-guide.md#L35-L47",
          "version": "repo-lines-v1:sha256:ba50d9789bac47aeb78c8b0be58c5016a66c7b51eeb9632461c33cf56926fe22:"
        }
      ]
    },
    {
      "id": "claim_0262938c22c0439f86d7f1fba3785a69",
      "statement": "ENS subscriptions are scoped per user per event type with only accountId and amount-threshold filters; ENS does not support subscribing to an individual entity (e.g. a specific paymentId), and producers needing to notify a specific pre-resolved recipient instead use the 'producer-resolved recipients' pattern (calling POST /ens/v3/notifications directly for a named user). Entity-level subscriptions are planned under ENS-1120, targeted 2027-H1.",
      "evidence": [
        {
          "resource": "repo://sources/estate/ens-int-3.2-enterprise-notification-service-integration-guide.md#L49-L51",
          "version": "repo-lines-v1:sha256:7b6750fc41945eae6836d5115964229ec2e5835b12941bb5e45adddb0e807434:"
        }
      ]
    },
    {
      "id": "claim_50f5da7940064618b308cccc103442f7",
      "statement": "The current Treasury (TRS) event catalog covers four live wire event types (TRS.WIRE.APPROVAL_REQUIRED, TRS.WIRE.RELEASED, TRS.WIRE.REJECTED, TRS.WIRE.INCOMING_POSTED) and two live ACH event types (TRS.ACH.STATUS_CHANGED, TRS.ACH.RETURN_RECEIVED); no event types are registered for wire network acceptance, beneficiary credit (gpi ACCC), wire returns, gpi milestones, or client action required on held wires.",
      "evidence": [
        {
          "resource": "repo://sources/estate/ens-int-3.2-enterprise-notification-service-integration-guide.md#L53-L75",
          "version": "repo-lines-v1:sha256:b8fbc8d2de9c295824e814b04f99f12a475ebd5f85774517fae258d3bf20c8b2:"
        }
      ]
    },
    {
      "id": "claim_2c48ef8347424267995e3cfc8858597e",
      "statement": "ENS exposes three public APIs: POST /ens/v3/notifications (EP-ENS-01) to send a registered event with an approved template, POST /ens/v3/subscriptions (EP-ENS-02) to create a subscription with eventType + accountId filter, and GET /ens/v3/event-types?domain=TRS (EP-ENS-03) to read the TRS event-type catalog.",
      "evidence": [
        {
          "resource": "repo://sources/estate/ens-int-3.2-enterprise-notification-service-integration-guide.md#L77-L83",
          "version": "repo-lines-v1:sha256:4f45975b846200812fde2391ef6afd25cb58b11f2bac4f9684677bbe291c229d:"
        }
      ]
    },
    {
      "id": "claim_762665671af14835abcfc59377b520b2",
      "statement": "ENS content rules require financial-crimes-related template copy to be FCC-approved per POL-FCC-014 Appendix B, require status wording to follow the producer's approved status terminology, and prohibit links that expose transaction data outside authenticated sessions.",
      "evidence": [
