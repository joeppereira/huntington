      "id": "claim_b2f5a54912b348aea6ce4ed1b98f6c13",
      "statement": "DUS-07 requires that data collected or derived for one purpose (e.g. fraud detection, AML, credit) not be reused for another purpose such as product features without Privacy Office approval (and FCC approval for financial-crimes data), with feature tables inheriting the most restrictive permitted purpose of their inputs.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L38-L40",
          "version": "repo-lines-v1:sha256:3aaddc7c397555a338a34b6ce226481dfe6f1ec0617e50f9b12bd7338bf99880:"
        }
      ]
    },
    {
      "id": "claim_e673610a43a2491d8a5c205258bd1919",
      "statement": "DUS-07 prohibits using information about one client, including its behavior as a counterparty, to generate content shown to another client, even if presented as an anonymized pattern or typical value.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L42-L44",
          "version": "repo-lines-v1:sha256:44f7824b941688d5f85ce2d547a0511eba13b594fd82035be0155bafc25e0643:"
        }
      ]
    },
    {
      "id": "claim_9297291454284ab1a7282efb56955ab8",
      "statement": "DUS-07 permits client-facing aggregated cohort statistics only when the cohort has at least 500 transactions, at least 20 distinct originating clients, no client over 15% of cohort volume, monthly refresh, and Disclosure Review Committee-approved wording; failing cohorts must be suppressed rather than approximated.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L46-L60",
          "version": "repo-lines-v1:sha256:b947da52469af808271803afaf573c53290020b53d6fda6fc78b9d28d4dc089f:"
        }
      ]
    },
    {
      "id": "claim_f371ec219e9447eea36c7f9c0f77a013",
      "statement": "DUS-07 allows a client's own historical transactions to be used for insights shown back to that client only if based on at least 5 comparable transactions and discloses the basis (count and period).",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L62-L72",
