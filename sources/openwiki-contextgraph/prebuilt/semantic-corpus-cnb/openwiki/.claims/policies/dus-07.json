  "claims": [
    {
      "id": "claim_42ce6833089b4ff38f46398dca081227",
      "statement": "DUS-07 v2.1 (Data Use & Client Confidentiality Standard) is a Privacy Office standard, document ID DUS-07, owned by Chief Privacy Officer Rachel Goldberg, approved by the Data Governance Council on 2026-01-08, effective 2026-01-15, classified INTERNAL - CONFIDENTIAL, and applies to both consumer clients (additionally covered by GLBA privacy provisions) and commercial clients (protected contractually under the Treasury Management Services Agreement s14).",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L15-L27",
          "version": "repo-lines-v1:sha256:464a3cf6911aa18516606f7ced87c71e6cb26782bf959462606ec5247581aa6f:"
        }
      ]
    },
    {
      "id": "claim_61cb4704eedb454ba207b85b64e1ece6",
      "statement": "DUS-07 defines four data classification tiers - Public, Internal, Confidential - Client, and Restricted - Client Confidential - used by downstream catalogs (e.g. TDIP) to scope permitted use of a dataset.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L29-L36",
          "version": "repo-lines-v1:sha256:94abbcc5548df607f507bacc34d66e9e9e19737aaea8dc682f5070fac18977fb:"
        }
      ]
    },
    {
      "id": "claim_7a62ce24559442fe94a26a19042442d6",
      "statement": "DUS-07 §3 (purpose limitation) prohibits using data collected or derived for one purpose (e.g. fraud detection, AML monitoring, credit) for another purpose, including product features, without Privacy Office approval and FCC approval for financial-crimes data; feature tables inherit the permitted purpose of their most restrictive input.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L38-L40",
          "version": "repo-lines-v1:sha256:3aaddc7c397555a338a34b6ce226481dfe6f1ec0617e50f9b12bd7338bf99880:"
        }
      ]
    },
    {
      "id": "claim_540d7e93a2f047109c84864b0810c767",
      "statement": "DUS-07 §4 (cross-client confidentiality) prohibits using information about one client - including a counterparty's post-receipt account behavior - to generate content shown to another client, even if presented as a pattern/typical value and even if the counterparty is unnamed.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L42-L44",
          "version": "repo-lines-v1:sha256:44f7824b941688d5f85ce2d547a0511eba13b594fd82035be0155bafc25e0643:"
        }
      ]
    },
    {
      "id": "claim_0d7a788b66e44b63ab474c6255bd3d2e",
      "statement": "DUS-07 §5 permits aggregated multi-client cohort statistics to be shown to clients only when, for the measurement window, the cohort has at least 500 transactions, at least 20 distinct originating clients, no single client contributing more than 15% of cohort volume, at least monthly refresh, and Disclosure Review Committee-approved wording/disclaimer; a cohort failing any condition must be suppressed, not rounded or approximated.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L46-L60",
          "version": "repo-lines-v1:sha256:b947da52469af808271803afaf573c53290020b53d6fda6fc78b9d28d4dc089f:"
        }
      ]
    },
    {
      "id": "claim_97becfe4dfbc4891a2883b8f9c2c4104",
      "statement": "DUS-07 §6 permits a client's own historical transactions to be used for insights shown to that same client (e.g. typical completion time for past wires to a beneficiary) only when the insight is based on at least 5 comparable transactions and states the basis (count and period); this threshold is distinct from and lower than the §5 multi-client cohort gates.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L62-L72",
          "version": "repo-lines-v1:sha256:3f6f35e288f0265e4076102e458c82e4c3c78c0b01048f4ebe9bf2fbd55c1519:"
        }
      ]
    },
    {
      "id": "claim_70435bbb903a4fe8a320cb3eedef1655",
      "statement": "DUS-07 §7 sets approval requirements: access to Restricted datasets requires data-owner plus Privacy Office sign-off via a Collibra Data Access Request with a 15-business-day SLA; new client-facing use of client data requires a Privacy Impact Assessment (~4 weeks); and use of financial-crimes data outside FCC purposes requires Privacy Office plus FCC approval and is generally not approved.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L74-L82",
          "version": "repo-lines-v1:sha256:5bfadaf88ee3be476e9d10af7d7995013a63e5637199d9eafffd6151b3f4e1b1:"
        }
      ]
    },
    {
      "id": "claim_0683b6fb11384552bfc6688e9f3cd299",
      "statement": "DUS-07 is one of several controls (alongside MRM-POL-02 model/EUA tiering and Disclosure Review Committee wording approval) that every new client-facing insight served through the TDIP Insights API must clear, per the platform's documented four-step onboarding sequence: MRM registration, DUS-07 data access approval, Insights API endpoint build, then DRC approval.",
      "evidence": [
