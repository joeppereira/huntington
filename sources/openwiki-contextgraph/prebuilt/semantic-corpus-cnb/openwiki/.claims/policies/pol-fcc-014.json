        }
      ]
    },
    {
      "id": "claim_47750349ec024e42a80ad7b2a3a8fde0",
      "statement": "POL-FCC-014's controlling regulatory basis spans 31 U.S.C. 5318(g)(2)/31 CFR 1020.320(e) (SAR confidentiality), 31 CFR Part 501 (OFAC blocking/reject reporting), UCC Article 4A/Regulation J (settlement finality), FFIEC authentication guidance, Section 5 of the FTC Act (UDAP), and CNB's Fair Representation Standard FRS-02.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L33-L42",
          "version": "repo-lines-v1:sha256:1d9cc71c39f3e2781c18c912e58a89aaf5201384b29156ff9bec70c15f1539b4:"
        }
      ]
    },
    {
      "id": "claim_4edc895ba07e417ba3cf563719bb9a78",
      "statement": "POL-FCC-014 Section 5.2 gates client-facing status terms (Sent/In transit, Delivered, Completed/Settled, Credited to beneficiary, Returned) on specific rail events such as Fedwire acceptance (pacs.002/OMAD) or SWIFT gpi ACCC, explicitly prohibiting 'Completed'/'Settled' on release, transmission, or network ACK/ACSP statuses alone.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L77-L86",
          "version": "repo-lines-v1:sha256:02c4cf15078950615a6b28997f2a0455c3d25985f70b061ef467564b47b7f767:"
        }
      ]
    },
    {
      "id": "claim_c7ce31f7aac7437da71fbd9d1a398823",
      "statement": "POL-FCC-014 Section 5.4 limits third-party status sharing (at a client's request) to amount, currency, value date, status milestones, and a cboRef/UETR reference, excludes account numbers/fees/internal references/hold information, requires links to expire within 7 days, client-administrator enablement, and InfoSec (SEC-STD-22) and Privacy design approval.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L92-L94",
          "version": "repo-lines-v1:sha256:5ebdbc5f61eb14e5894c62b75eb02728afa285362f605c549ee824a240c90f7a:"
        }
      ]
    },
    {
      "id": "claim_1d9f16c8bd6b45d998d4bf08918ac3b3",
      "statement": "POL-FCC-014 Section 5.5 requires client-facing predictive/insight statements to use only the client's own data or DUS-07 Section 5 compliant aggregated cohorts, be registered with Model Risk Management under MRM-POL-02 where applicable, carry a DRC-approved disclaimer, and never be shown for payments in tier G or R hold.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L96-L98",
          "version": "repo-lines-v1:sha256:e99d2baf094f5a6a7951d7f4bd04314935a767e989b1c67ff71ef7cc922497f3:"
        }
      ]
    },
    {
      "id": "claim_2dde95872b694b1abeded675758cef06",
      "statement": "POL-FCC-014 Appendix A binds each of the 12 HRC hold-reason codes to a disclosure tier, an approved copy key, and a permitted client action, with tier-R codes HRC-07 through HRC-11 and tier-G code HRC-12 all mapping to the identical generic copy key COPY-HOLD-GEN-01 and no client action, operationalizing the tier R/G indistinguishability requirement.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L104-L131",
          "version": "repo-lines-v1:sha256:128251074780063dae372c92f6da039abe07147948a0f522c071012a53df6dc6:"
        }
      ]
    },
    {
      "id": "claim_66849cc482024b4cb7deb996d846c393",
      "statement": "POL-FCC-014 Appendix C maintains a denylist of terms (fraud, suspicious, sanctions, OFAC, watch list, screening hit, AML, compliance review, investigation, flagged, security alert, risk score, law enforcement, blocked) that must never appear in client-facing copy, except 'blocked' in Sanctions Operations correspondence.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L145-L147",
          "version": "repo-lines-v1:sha256:87df57cc6e319fd41609710b032e4544d299eccc5d31422d5a2dd63255e77665:"
        }
      ]
    },
    {
      "id": "claim_600960caee4244d08c3ab4f1b26b24bd",
      "statement": "POL-FCC-014 Section 6 requires FCC Policy & Advisory review before build commitment and Disclosure Review Committee (DRC) approval of final copy for any new or changed client-facing status, hold, or exception experience, with exceptions requiring Chief BSA/AML Officer approval; this gate applies to CBO Wire Center UI, ENS notification templates, and TDIP-served client insights.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L100-L102",
          "version": "repo-lines-v1:sha256:df3fcb6237816c88e8de3094ed2fef1d4e917b1307ab6ec0e9a7e54c2a3ddaba:"
        }
      ]
    },
    {
      "id": "claim_8bebaee6382444f8ba1906c03882c7df",
      "statement": "POL-FCC-014 Section 5.1 requires that Restricted (tier R) hold reasons, codes, scores, list names, match details, analyst notes and queue names never be displayed, transmitted or implied in any client-facing channel, that no estimated release time or likelihood language be shown for tier G or R holds (CTRL-PAY-040), that HRC-02 callback verification never be satisfied by in-channel confirmation (CTRL-PAY-018), and that sanctions blocks/rejects be communicated only by Sanctions Operations.",
