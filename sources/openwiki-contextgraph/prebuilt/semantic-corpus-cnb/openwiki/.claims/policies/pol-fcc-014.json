    {
      "id": "claim_f04dd5547a6e41a4bb48f1321f2ffae6",
      "statement": "POL-FCC-014 v3.2 defines a four-tier disclosure model (P/C/G/R) governing what client-facing channels may show for payment status, holds, and exceptions, with tier R required to be presented identically to tier G so clients cannot infer the nature of a sensitive review.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L44-L51",
