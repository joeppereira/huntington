    {
      "id": "claim_14a6bcd4b6d3427ab811030028c7a023",
      "statement": "The Insights API (established by ADR-PAY-026) serves client-facing analytical outputs by computing results inside TDIP in batch or micro-batch, publishing them to a serving store, and exposing them through versioned endpoints, with entitlement/authorization checks delegated to the calling channel rather than enforced by the Insights API itself.",
      "evidence": [
        {
          "resource": "repo://sources/estate/tdip-cat-2026.2-treasury-data-and-insights-platform-data-catalog-extract.md#L73-L73",
          "version": "repo-lines-v1:sha256:da1ce65b6d3bb38c7869b3067eb2e0362ee7d7b9c20c073b662aecc29107a5df:"
        }
      ]
    },
    {
      "id": "claim_87dfa6c567e441a6a344b4da79df0f92",
      "statement": "EP-TDIP-01 (GET /tdip/insights/v1/cash-forecast/{clientId}) is the only GA Insights API endpoint, live since 2025-09, backed by model M-TRS-0142, with p95 latency of 120 ms, and is treated as the reference implementation for future endpoints.",
      "evidence": [
        {
          "resource": "repo://sources/estate/tdip-cat-2026.2-treasury-data-and-insights-platform-data-catalog-extract.md#L75-L77",
