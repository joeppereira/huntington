  "claims": [
    {
      "id": "claim_060b2c39333947bb910d30b306344363",
      "statement": "PIR-2024-07 is the Final v1.1 post-implementation review for the Wire Status Lite pilot (CBO-3120) and incident INC-2024-1182, owned by Tom Becker (EM, CBO Wire Center) and approved by Anjali Deshpande, Raymond Ortiz, and Denise Carter, last reviewed 2024-07-15.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pir-2024-07-wire-status-lite-pilot-inc-2024-1182-post-implementation-review.md#L15-L22",
          "version": "repo-lines-v1:sha256:7dce6ceac1307f9550ac0affd4ce793165a805abb8fcae169f69c12a6a7c0063:"
        }
      ]
    },
    {
      "id": "claim_447aa9946b1541dba158ff7201c30c2c",
      "statement": "The Wire Status Lite pilot auto-refreshed wire status for 60 clients by polling the PPH v1 status API from the browser every 30 seconds; on 2024-05-31 month-end, combined pilot and production traffic reached ~85 TPS, exhausting the PPH API thread pool and delaying wire release 47 minutes, leading to pilot termination and epic closure.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pir-2024-07-wire-status-lite-pilot-inc-2024-1182-post-implementation-review.md#L24-L26",
          "version": "repo-lines-v1:sha256:47c1705db6ff961019a77cb29b6253eeb8c9aac385661d336843d74208a8cabd:"
        }
      ]
    },
    {
      "id": "claim_550c3aee31894b619785c6c3606fd8c7",
      "statement": "The incident's quantified impact was 1,240 delayed wires, 312 wires released after the 6:00 p.m. ET Fedwire cutoff (value next day), and compensation of $41,800 across 14 clients; no regulatory notification was required since no data exposure occurred.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pir-2024-07-wire-status-lite-pilot-inc-2024-1182-post-implementation-review.md#L28-L35",
          "version": "repo-lines-v1:sha256:fe074407839fd331189b7b2809338c4ee513b6e599547aa968351919c79a00a8:"
        }
      ]
    },
    {
      "id": "claim_2bb129243e204265ae8222083c60765c",
      "statement": "PIR-2024-07 found that 37% of surveyed pilot users believed a 'Processed' wire status meant the beneficiary had received funds, and that Treasury Support could not explain wire holds to clients without FCC guidance.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pir-2024-07-wire-status-lite-pilot-inc-2024-1182-post-implementation-review.md#L37-L43",
          "version": "repo-lines-v1:sha256:c13cc30ea9aeac03b0e805756b86daeffe12820d3bfe0b608f80179424daaa42:"
        }
      ]
    },
    {
      "id": "claim_d6f2bd2c6ee54de798f1f4967e44fcf9",
      "statement": "PIR-2024-07 identifies three root causes: a polling architecture against a shared synchronous API with no client-side backoff, no capacity testing at month-end volumes, and status semantics exposed to clients without prior Compliance/Legal validation.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pir-2024-07-wire-status-lite-pilot-inc-2024-1182-post-implementation-review.md#L45-L51",
          "version": "repo-lines-v1:sha256:9e71d2f93a360cfa2460e517259613f7b7db12d400b3196ac826dd19f447e343:"
        }
      ]
    },
    {
      "id": "claim_e3547fbccef649b2b69dddaa374678db",
      "statement": "PIR-2024-07's remediation actions included rate-limiting the PPH v1 status API to 20 TPS shared (done 2024-06), adopting an event-driven status pattern that became ADR-PAY-019 (done 2024-06), building a reusable status projection service delivered for ACH in 2025 as CBO-3815, and an open carry-forward action to validate client-facing status terminology with FCC and Legal before future tracking features.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pir-2024-07-wire-status-lite-pilot-inc-2024-1182-post-implementation-review.md#L53-L60",
          "version": "repo-lines-v1:sha256:48e33e8afd5d89a9891ca2815cbb357d002f93967de9d8394a7e0632cdb08305:"
        }
      ]
    }
  ],
