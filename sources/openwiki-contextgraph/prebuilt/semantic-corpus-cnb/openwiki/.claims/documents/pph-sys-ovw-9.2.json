    {
      "id": "claim_987caa5693e247c49797ca049306624b",
      "statement": "PRISM Payments Hub (PPH) is CNB's wire orchestration platform for all channels and rails (Fedwire, Swift CBPR+, book transfer), built on the vendor Volaris Payment Platform 9.4 and operated on-premises in an active-active configuration across the Columbus and Charlotte data centers.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L26-L26",
