        }
      ]
    },
    {
      "id": "claim_17399a8380184d1c957eee7b4d346059",
      "statement": "The Volaris 9.6 upgrade scheduled for April 2027 removes the legacy PPH v1 API adapter, which is the technical driver for the PPH v1 API sunset on 2027-03-31 tracked under PPH-2190.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L138-L138",
