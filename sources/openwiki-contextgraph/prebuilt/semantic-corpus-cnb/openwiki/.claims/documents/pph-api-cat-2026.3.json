    },
    {
      "id": "claim_d0de7baf6ffe4d279c81540915811cce",
      "statement": "The v2 payment detail endpoint EP-PPH-04 (GET /pph/v2/payments/{paymentId}) replaces the v1 status string with lifecycleState plus structured identifiers (cboRef, imad, omad, uetr, endToEndId), network, hold, charges and return objects, but v2 has no settlement object; rail-specific settlement status and Fed acceptance timestamp are proposed separately under backlog item PPH-2207 (no product sponsor), and intermediary/beneficiary bank charges are unknown to PPH in both versions.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-api-cat-2026.3-prism-payments-hub-api-and-event-catalog.md#L77-L104",
          "version": "repo-lines-v1:sha256:e863fdede7c9c8bd20227def730ee17c2f368e752aa03e1e6c797742c2e1ff98:"
        }
