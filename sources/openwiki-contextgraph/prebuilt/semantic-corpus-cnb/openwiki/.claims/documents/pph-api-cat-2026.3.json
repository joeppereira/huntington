    {
      "id": "claim_ee5a89f3561c431cbe58467269e33ed2",
      "statement": "v1 endpoint EP-PPH-01 (GET /pph/v1/wires/{wireRef}/status) returns a coarse status enum where PROCESSED aggregates RELEASED, SENT_TO_NETWORK, NETWORK_ACCEPTED and COMPLETED, exposes a legacy free-text holdReasonDesc synced from HMS since 2019 (dropped in v2 per ADR-PAY-021), and returns fedRef as IMAD only with no OMAD or UETR.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-api-cat-2026.3-prism-payments-hub-api-and-event-catalog.md#L39-L65",
          "version": "repo-lines-v1:sha256:11a2c168ae3824b34a7d20a32112ee46558a045f182b99b8b6918cf44f42be48:"
        }
