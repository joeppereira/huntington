  "claims": [
    {
      "id": "claim_d7d9925e71e24ed185b0927071e467a9",
      "statement": "POL-FCC-014 v3.2 is an INTERNAL-CONFIDENTIAL enterprise standard owned by Catherine Doyle (EVP, Chief BSA/AML Officer) with co-owner Michael Tran (SVP, OFAC/Sanctions Officer), approved by the Enterprise Policy Committee on 2026-02-12, effective 2026-03-01 with next review 2027-03-01.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L15-L23",
          "version": "repo-lines-v1:sha256:47a568773085c3771cb225bfe950df86c860dac9f1271c0ee9e7930c5e8985c8:"
        }
      ]
    },
    {
      "id": "claim_585f1ba23378448db8420370a154d56d",
      "statement": "The standard applies across all client-facing channels: Crestline Business Online (web/mobile), APIs and host-to-host status files, notifications (email/SMS/push/in-app), Commercial Service Center scripts, relationship manager communications, downloadable reports, and third-party-shared content.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L29-L31",
          "version": "repo-lines-v1:sha256:92ec8f390cc528ef0d1c9c3caa3517ee53d906b0d4a1c1ba3a9ea4ce5033306e:"
        }
      ]
    },
    {
      "id": "claim_55cd36bc095941368a5ab9f0424334d1",
      "statement": "The standard defines four client disclosure tiers (P public, C client-actionable, G generic review, R restricted), and mandates that tier R be presented identically to tier G (same label, icon, color, copy, actions, and absence of timing) so clients cannot infer the nature of a sensitive review.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L44-L51",
          "version": "repo-lines-v1:sha256:de2e7d7895beb0c76c9802ac5bb4352c754a6f20c1ab7ecb7e0e495f64ead307:"
        },
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L67-L67",
          "version": "repo-lines-v1:sha256:69fa088f750de7713234492ab9b2d486060cdc457e3943ecf89a4f15d33873fd:"
        }
      ]
    },
    {
      "id": "claim_0b93dd15fc764577941052556e186010",
      "statement": "Restricted-tier (R) reasons, hold codes, scores, list names, match details, analyst notes, and queue names must never be displayed, transmitted, or implied in any client-facing channel, and no estimated release time or next-steps timing may be shown for tier G or R holds per control CTRL-PAY-040.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L65-L69",
          "version": "repo-lines-v1:sha256:6c90ea864869597b396b4ae0cbe0b66de068c88b370647a02817146980d8ec43:"
        }
      ]
    },
    {
      "id": "claim_957684126a774692bc7b158a7494e5e4",
      "statement": "Callback verification for hold HRC-02 (CALLBACK_REQUIRED) cannot be satisfied by any in-channel confirmation from the payment-initiating channel per control CTRL-PAY-018; the channel may only show that a callback is pending and let the client request one, with verification via callback to the contact on file.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L109-L110",
          "version": "repo-lines-v1:sha256:ff1553e3eea507884446788f490ff9b5fbcb8ceaf76a606da36d8aad77c001a3:"
        },
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L73-L73",
          "version": "repo-lines-v1:sha256:1450a27ad8aa98c69cf7d5dd7534730c7a638e3c1c937a4ff84ca6ed180bf678:"
        }
      ]
    },
    {
      "id": "claim_479c7882822f4f5b8a5e08305ff093d7",
      "statement": "Status terminology is gated on specific payment-rail events rather than internal processing milestones: e.g., 'Delivered to beneficiary's bank' requires Fedwire acceptance (pacs.002 with OMAD), and 'Completed/Settled' requires Fedwire acceptance domestically or gpi ACCC internationally, not merely release, transmission, or SWIFT ACK/ACSP statuses.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L79-L86",
          "version": "repo-lines-v1:sha256:b812e4526c1d0ac5ec5a9c42d03dea9155afacbb98aeb7cfddadf39e2cd52f13:"
        }
      ]
    },
    {
      "id": "claim_7852ce1005c34631b6225bf4e57a2c52",
      "statement": "Status shared with a third party at a client's request is limited to amount, currency, value date, status milestones, and a reference (cboRef or UETR), excluding account numbers, fees, internal references, and hold information; sharing links must expire within 7 days, be enabled by a client administrator, and receive InfoSec (SEC-STD-22) and Privacy approval.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L92-L94",
          "version": "repo-lines-v1:sha256:5ebdbc5f61eb14e5894c62b75eb02728afa285362f605c549ee824a240c90f7a:"
        }
      ]
    },
    {
      "id": "claim_6af2f692b748484dba94977725e5b8aa",
      "statement": "Client-facing predictive/insight statements (e.g., typical completion times) must use only the client's own data or DUS-07-compliant aggregated cohorts, be registered with Model Risk Management under MRM-POL-02 where applicable, carry a DRC-approved disclaimer, and never be shown for payments in tier G or R hold.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L96-L98",
          "version": "repo-lines-v1:sha256:e99d2baf094f5a6a7951d7f4bd04314935a767e989b1c67ff71ef7cc922497f3:"
        }
      ]
    },
    {
      "id": "claim_8c568412459c4f4c97215ab917652ee3",
      "statement": "Appendix A maps 12 Hold/Review Codes (HRC-01 through HRC-12) to a disclosure tier, an approved copy key, and a permitted client action; HRC-07 through HRC-11 (fraud, account takeover, sanctions, AML, legal hold — all tier R) share the identical copy key COPY-HOLD-GEN-01 with HRC-12 (OPS_MANUAL_REVIEW, tier G), operationalizing the tier G/R indistinguishability requirement.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L106-L131",
          "version": "repo-lines-v1:sha256:8beeaf78f5dccd7fe281ff8fbecb429514a021fcd0cf605a3bb3de4ec2ebd31c:"
        }
      ]
    },
    {
      "id": "claim_cf1ff04ec38346da9d27eba79b06a2d4",
      "statement": "The standard maintains a denylist of terms prohibited in client-facing copy (e.g., fraud, suspicious, sanctions, OFAC, watch list, AML, compliance review, investigation, flagged, security alert, risk score, law enforcement, blocked), with an exception for Sanctions Operations correspondence.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L145-L147",
          "version": "repo-lines-v1:sha256:87df57cc6e319fd41609710b032e4544d299eccc5d31422d5a2dd63255e77665:"
        }
      ]
    },
    {
      "id": "claim_b1f4503c71dc4ed69eeba99ae12be526",
      "statement": "New or changed client-facing status, hold, or exception experiences require FCC Policy & Advisory review before build commitment and DRC approval of final copy; exceptions to the standard require Chief BSA/AML Officer approval.",
