    {
      "id": "claim_7147fcdfd2e9479d884478ca42f268f7",
      "statement": "Wire Center maps PPH v1 wire statuses to client-facing labels (e.g., RECEIVED→Submitted, PENDING→In Process, HELD→Pending Review, PROCESSED→Completed, REJECTED→Rejected, CANCELLED→Cancelled, RETURNED→Returned); the 'Completed' label replaced 'Processed' in release R26.1 (tracked as CBO-4402) after client feedback that 'Processed' was unclear, and held wires show only the generic text 'This wire is being reviewed.' without exposing the underlying hold reason.",
      "evidence": [
        {
          "resource": "repo://sources/estate/cbo-arch-wc-4.1-wire-center-current-state-architecture.md#L80-L95",
          "version": "repo-lines-v1:sha256:0404441262518543b59a77e054e8aefe0f39ba9f0898b26f9c760960aa1d64cc:"
        }
      ]
    },
    {
