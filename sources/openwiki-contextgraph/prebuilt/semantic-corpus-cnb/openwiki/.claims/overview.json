    {
      "id": "claim_84cfcfa476fc4a019c9dd974c4b172c5",
      "statement": "POL-FCC-014 requires tier G (generic review) and tier R (restricted: fraud, account takeover, sanctions, AML, legal hold) holds to be presented identically to clients, with no estimated release time or next-step timing shown for either tier, so that a client cannot infer the nature of the review; only tier C (client-actionable) holds carry an approved explanation and permitted client action.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L104-L131",
