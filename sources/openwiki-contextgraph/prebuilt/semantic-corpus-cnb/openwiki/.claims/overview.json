    {
      "id": "claim_269d72ed3eff4b4488d8fd0593310ee6",
      "statement": "A 2024 client survey from the Wire Status Lite pilot found 37% of surveyed users believed the status label meaning 'Processed' indicated the beneficiary had received the funds, and a 2026 client complaint (CBO-4419 / CMP-2026-1189) shows a wire displayed 'Completed' at release before the beneficiary bank rejected it the next day.",
      "evidence": [
        {
          "resource": "repo://sources/estate/jira-export-wt-discovery-2026-10-05.md#L99-L105",
          "version": "repo-lines-v1:sha256:53c8e075e2a2238436ddd729cfbb94c76ca723bb718379669e7c0fd55e25e75c:"
