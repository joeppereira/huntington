    {
      "id": "claim_3ecd54483a354cf9a8a7a57f4330945c",
      "statement": "ADR-PAY-019 requires channel status integrations to be event-driven rather than polling PPH; this decision followed INC-2024-1182, in which the Wire Status Lite pilot's 30-second auto-refresh drove roughly 85 TPS to the PPH v1 status API at month-end, exhausted its thread pool, and delayed wire release for 47 minutes, delaying 1,240 wires and causing 312 to miss the Fedwire customer cutoff.",
      "evidence": [
        {
          "resource": "repo://sources/estate/arb-pay-reg-2026q3-payments-arb-adr-register-and-minutes.md#L34-L36",
          "version": "repo-lines-v1:sha256:1f35aa53be2f9b72dd8b1c998aa1932b987c28459a606949eef4cce03bb1b7c2:"
        },
        {
          "resource": "repo://sources/estate/pir-2024-07-wire-status-lite-pilot-inc-2024-1182-post-implementation-review.md#L24-L34",
          "version": "repo-lines-v1:sha256:cbab715e73d2c3ca245f93e432ae97a95214a9affe9da24612552ef5ae876176:"
        }
      ]
    },
    {
      "id": "claim_4b550776e944483d9f61ba7b2c92ca7b",
      "statement": "CBO Wire Center is limited to user-initiated, throttled status refresh (1 request per 60 seconds per wire) against the PPH v1 status endpoint and performs no background polling, per ADR-PAY-019.",
      "evidence": [
        {
          "resource": "repo://sources/estate/cbo-arch-wc-4.1-wire-center-current-state-architecture.md#L125-L129",
