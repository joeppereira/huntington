    {
      "id": "claim_6191bd1f096d4d37bd4ea14c27e4189b",
      "statement": "International (Swift gpi) tracking data is produced only by a 4-hour batch pull from the Swift Tracker API into the Oracle table GPI_TRACKER_SNAPSHOT; there is no internal API for gpi status, and the snapshot must not be exposed directly to client channels.",
      "evidence": [
        {
          "resource": "repo://sources/estate/png-tdd-6.0-payment-network-gateway-fedwire-and-gpi-technical-design.md#L75-L88",
          "version": "repo-lines-v1:sha256:1f0395eab4407be1919e76a4e6adf03a2e25c07170a4c4f314773c29a1e5de6b:"
        }
      ]
    },
    {
      "id": "claim_e6d898c6517949cf90e9e8dbf43e7ea6",
      "statement": "A request to increase gpi Tracker batch frequency from 4 hours to 2 hours (PNG-1544) was declined because it would exceed the contracted Swift Tracker API quota of 250,000 calls/month; a client-facing per-payment lookup design was estimated at roughly 1.9 million calls/month, about 7x the contract, so any real-time design must use an internal change-feed rather than per-payment calls.",
      "evidence": [
        {
          "resource": "repo://sources/estate/png-tdd-6.0-payment-network-gateway-fedwire-and-gpi-technical-design.md#L133-L135",
          "version": "repo-lines-v1:sha256:00263be13e89ea76af66a97bbaf429d9283eee22e0099e95e24302741d3f2ecf:"
