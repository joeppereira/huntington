  "claims": [
    {
      "id": "claim_a842b7b7c43f4fffb864dd4e5650aed7",
      "statement": "CBO Wire Center (the commercial digital banking channel) submits wires to PRISM Payments Hub (PPH) exclusively through PPH v1 REST APIs (POST /pph/v1/wires, GET /pph/v1/wires status and list) and does not use PPH v2 APIs, gpi data, HMS APIs, or TDIP Insights.",
      "evidence": [
        {
          "resource": "repo://sources/estate/cbo-arch-wc-4.1-wire-center-current-state-architecture.md#L41-L56",
          "version": "repo-lines-v1:sha256:14912d6f944690950f70c45d832e37e71c4d61236fde5cbdee297ab0f9fcf8f0:"
        }
      ]
    },
    {
      "id": "claim_54dd66cb96a443518e04e82438c3d6aa",
      "statement": "PPH orchestrates the wire lifecycle by validating and enriching instructions, calling PRSP (SanctionScreen + Sentinel) synchronously for screening, performing funds control against the Core Deposit Platform, and then releasing to the Payment Network Gateway (Fedwire Funds Connector or Swift Alliance/gpi Connector) for transmission.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L24-L52",
          "version": "repo-lines-v1:sha256:4d3fa81c9be62e33e6b98a72e2a03e0c787e5ed0a9d2d4dc788d2514ce20cee4:"
        }
      ]
    },
    {
      "id": "claim_56dd92b82ee54593a847d59a82038d03",
      "statement": "The Payment Network Gateway has two rail-specific modules: the Fedwire Funds Connector (SYS-PNG-FFC) and the Swift Alliance & gpi Connector (SYS-PNG-GPI), both historically owned by Payment Networks Engineering (PNE).",
      "evidence": [
        {
          "resource": "repo://sources/estate/png-tdd-6.0-payment-network-gateway-fedwire-and-gpi-technical-design.md#L24-L28",
          "version": "repo-lines-v1:sha256:ab82a32de5ae3775b4013c0940c7b88874630711b176399ebb37eabfe9a36f1a:"
        }
      ]
    },
    {
      "id": "claim_eff856a7837641b5bad2adca3f596962",
      "statement": "Effective 2026-10-01, ownership of the Swift Alliance gateway, the gpi Connector, SwiftNet PKI service accounts, and the international wire tracking roadmap moved from Payment Networks Engineering to Global Transaction Services Integration (GTSI); the Fedwire Funds Connector remained with PNE, which additionally took on FedNow/RTP connector ownership from 2026-11-01.",
      "evidence": [
        {
          "resource": "repo://sources/estate/cnb-memo-2026-09-realignment-of-cross-border-network-integration.md#L28-L42",
          "version": "repo-lines-v1:sha256:406e7d21cd3cf4c002098b353c16d1226deed5affc7638754b2be98026f52e59:"
        }
      ]
    },
    {
      "id": "claim_05f7253d7c6b40ed83d9361dba26e7a5",
      "statement": "PPH's v1 status API collapses the v2 canonical states RELEASED, SENT_TO_NETWORK, NETWORK_ACCEPTED, and COMPLETED into a single v1 value PROCESSED, so v1 consumers cannot distinguish a merely-released wire from one acknowledged by the network or closed.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pph-api-cat-2026.3-prism-payments-hub-api-and-event-catalog.md#L61-L65",
          "version": "repo-lines-v1:sha256:d4501b71b5b2ea48a7d8ba67b23dba2212f30b0cee810786d5ee39e203037bb5:"
        },
        {
          "resource": "repo://sources/estate/pph-sys-ovw-9.2-prism-payments-hub-system-overview-and-lifecycle-state-model.md#L84-L86",
          "version": "repo-lines-v1:sha256:21738d3037172c3ba6816e77abf591c6152ee6ae1e7ab488a7c1e382e9d03f23:"
        }
      ]
    },
    {
      "id": "claim_1dc553eccb3c441eba25c8d2866f8e68",
      "statement": "CBO Wire Center maps the PPH v1 PROCESSED status to the client-facing label 'Completed' (replacing the earlier label 'Processed' in release R26.1 per story CBO-4402), even though PROCESSED does not confirm beneficiary credit for either Fedwire or Swift wires.",
      "evidence": [
        {
          "resource": "repo://sources/estate/cbo-arch-wc-4.1-wire-center-current-state-architecture.md#L80-L94",
          "version": "repo-lines-v1:sha256:67cc6b29dfe95db511d67a7247e4f2dba3e837cd94d59a891b6400c2013e571c:"
