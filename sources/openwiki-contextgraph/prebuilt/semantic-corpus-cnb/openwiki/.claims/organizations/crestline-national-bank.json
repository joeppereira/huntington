    {
      "id": "claim_beb411f80b5844fe8eaf60538a54f990",
      "statement": "The Data Use & Client Confidentiality Standard (DUS-07), owned by the Chief Privacy Officer, enforces purpose limitation on client data reuse and requires aggregated cohort statistics shown to clients to meet minimum thresholds (>=500 transactions, >=20 distinct clients, no client >15% of volume, monthly refresh, DRC-approved wording), suppressing cohorts that fail any condition.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L38-L60",
          "version": "repo-lines-v1:sha256:550f69407f0fb2dec5505d98785a9af47d6ab39405c355036482c216ac00a6b6:"
        }
      ]
    },
    {
      "id": "claim_862408c9fad34f5db1b15d0a15f0bbe6",
      "statement": "The Model Risk Management Policy (MRM-POL-02), owned by the Head of Model Risk Management and aligned to 2026 interagency guidance, defines 'model' to require meaningful complexity, creates an End-User Analytic category for simple descriptive calculations, and tiers customer-facing estimates (Tier 2) for mandatory independent validation (10-14 weeks, 160-240 validator hours) before use.",
      "evidence": [
        {
