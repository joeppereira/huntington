    {
      "id": "claim_905c7baa583947c485afabf694ab798a",
      "statement": "POL-FCC-014 (Customer Communication of Payment Status, Holds and Exceptions Standard), owned by the Chief BSA/AML Officer with the OFAC/Sanctions Officer as co-owner, applies to all client-facing channels and artifacts (CBO, APIs/host-to-host files, notifications, Commercial Service Center scripts, RM communications, reports, third-party sharing) and is grounded in SAR confidentiality law, OFAC blocking rules, UCC Article 4A/Regulation J finality, FFIEC risk-based authentication guidance, and FTC Act UDAP prohibitions.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L25-L42",
          "version": "repo-lines-v1:sha256:159b606a3782e70ab317eaaa5b5d400f7335e6e84e4e993e55ad5ee974a6c90e:"
        }
      ]
    },
    {
      "id": "claim_927fb52f428d4672b8218c233baff1be",
      "statement": "POL-FCC-014 defines four client disclosure tiers (Public, Client-actionable, Generic review, Restricted) and requires that Restricted holds (fraud, account takeover, sanctions, AML, legal) be presented identically to Generic holds with no hold code, reason, score, queue name, or timing/likelihood-of-release information ever exposed to the client.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L44-L69",
          "version": "repo-lines-v1:sha256:9b683e55b787dc838156a74cdc2568798a8a7bb9f8ad71c4c9d983196da37c77:"
        }
      ]
    },
    {
      "id": "claim_6754eb5f6bf2413eb25c4ea0bf564c21",
      "statement": "POL-FCC-014 fixes permitted payment-status terminology to specific network events (e.g., 'Delivered to beneficiary's bank' only after Fedwire acceptance; 'Completed/Settled' only after Fedwire acceptance or gpi ACCC), restricts third-party status sharing to amount/currency/value date/status milestones/reference excluding account numbers and hold information, and requires any predictive/typical-completion-time statement to use only the client's own data or a DUS-07-compliant cohort, be MRM-registered where applicable, and carry a DRC-approved disclaimer, never for tier G/R holds.",
      "evidence": [
        {
          "resource": "repo://sources/estate/pol-fcc-014-v3.2-customer-communication-of-payment-status-holds-and-exceptions-standard.md#L77-L98",
          "version": "repo-lines-v1:sha256:49951c20fc614b45c9fc4fa5fbad167db38a5a9baa9c50e713855db6af51ea55:"
        }
      ]
    },
