        }
      ]
    },
    {
      "id": "claim_76492641db3742e4a38571a1e9f59949",
      "statement": "Internal HMS endpoints EP-HMS-01 (GET /prsp/hms/v1/holds?paymentId=, returning hrcCode, category, description, analystNotes, slaDueTs) and EP-HMS-02 (POST /prsp/hms/v1/holds/{holdId}/disposition, maker-checker under CTRL-PAY-012) are limited to the Investigations Workbench and PPH's legacy sync, not to channels.",
      "evidence": [
