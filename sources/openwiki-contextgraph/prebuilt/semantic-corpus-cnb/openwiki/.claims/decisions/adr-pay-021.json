  "claims": [
    {
      "id": "claim_bdf7cb8d82c54412a9c19395f68d9ea8",
      "statement": "ADR-PAY-021, accepted 2025-04-08 and applying to PPH v2, channels, and data, decides that hold reason codes, descriptions, scores, and analyst notes must remain within financial-crimes trust (FCT) systems, with PPH v2 and payment lifecycle events exposing only hold presence and holdId.",
      "evidence": [
        {
          "resource": "repo://sources/estate/arb-pay-reg-2026q3-payments-arb-adr-register-and-minutes.md#L30-L40",
          "version": "repo-lines-v1:sha256:b925fb09b98dfc847350831b2efe94c645bd37d70bd6b329db11dd22b31410d0:"
        }
      ]
    },
    {
      "id": "claim_16dd7d7a1417459ebbc69266fef76f42",
      "statement": "Under ADR-PAY-021, any client-facing hold explanation must come from an FCT-owned, FCC-approved facade returning a disclosure tier and approved copy rather than raw hold reasons; legacy PPH v1's holdReasonDesc field is a documented exception retained until v1 sunset.",
      "evidence": [
        {
          "resource": "repo://sources/estate/arb-pay-reg-2026q3-payments-arb-adr-register-and-minutes.md#L38-L40",
          "version": "repo-lines-v1:sha256:c8d677a33290573aa826e7fd4b7df5371c019bfddffe7c6cd8118863c079d690:"
        }
      ]
    },
    {
      "id": "claim_ac6378a08eda45108b353fabb31cd070",
      "statement": "The Hold Management Service (HMS) is the system of record for payment holds and is part of the Payment Risk & Screening Platform (PRSP) alongside Sentinel Fraud Scoring and SanctionScreen; hold work queues are surfaced to Payment Operations and the FIU via the Investigations Workbench.",
      "evidence": [
        {
          "resource": "repo://sources/estate/prsp-hms-3.4-hold-management-service-design-and-reason-taxonomy-restricted.md#L24-L26",
          "version": "repo-lines-v1:sha256:f6fb690120df161b152daf802cd9a5d75abcf329a7d1f3edc5375f7506369281:"
        }
      ]
    },
    {
      "id": "claim_7f52fdf3298e4ee7a472f224712de854",
      "statement": "HMS holds progress through the lifecycle states OPEN, IN_REVIEW, ESCALATED, RELEASED, REJECTED, BLOCKED, and EXPIRED, with BLOCKED requiring OFAC reporting within 10 business days under 31 CFR 501.603.",
      "evidence": [
        {
          "resource": "repo://sources/estate/prsp-hms-3.4-hold-management-service-design-and-reason-taxonomy-restricted.md#L28-L38",
          "version": "repo-lines-v1:sha256:3289fc66d676d11e5fff1066c372a6656b4e757edd15a85e02a56238b140704d:"
        }
      ]
    },
    {
      "id": "claim_b3a6a8ef65c646049bd0ebb4a74f3e42",
      "statement": "HMS defines twelve hold reason codes (HRC-01 through HRC-12) each assigned a disclosure tier (P, C, G, or R) per POL-FCC-014, and classifies hold description and analystNotes fields as Restricted, with descriptions templated to include sensitive detail such as fraud model scores and sanctions match confidence.",
      "evidence": [
        {
          "resource": "repo://sources/estate/prsp-hms-3.4-hold-management-service-design-and-reason-taxonomy-restricted.md#L40-L56",
          "version": "repo-lines-v1:sha256:8ced1cf701cd15ac4f63a4ed5a3717f239087530fad1bd3ca3f5e30caf67556c:"
