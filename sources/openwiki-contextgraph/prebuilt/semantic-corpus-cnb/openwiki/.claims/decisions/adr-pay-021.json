          "version": "repo-lines-v1:sha256:7cd87a8716a79d7571fc8d13c933eb405e432990ed11d928c7c79e1e41a44278:"
        }
      ]
    },
    {
      "id": "claim_cc605d93b4dd43adbe898f6adbe9b3a2",
      "statement": "The HMS-to-PPH description sync feeding legacy PPH v1's holdReasonDesc field predates ADR-PAY-021 and remains active only for v1 backward compatibility, tracked as open risk FCT-2004.",
      "evidence": [
