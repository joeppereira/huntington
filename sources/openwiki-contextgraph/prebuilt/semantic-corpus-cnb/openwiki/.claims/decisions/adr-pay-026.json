  "claims": [
    {
      "id": "claim_b0006bca6adb408f8d92c14a1ca0f9d0",
      "statement": "ADR-PAY-026, decided 2026-05-12 by the Payments Architecture Review Board and published 2026-09-12, requires that predictions, typical-time statistics and other analytical outputs shown to clients be computed in TDIP and served via versioned TDIP Insights API endpoints, and explicitly prohibits channel BFFs from computing analytics.",
      "evidence": [
        {
          "resource": "repo://sources/estate/arb-pay-reg-2026q3-payments-arb-adr-register-and-minutes.md#L32-L32",
          "version": "repo-lines-v1:sha256:dc794aafe4ca5bd997070616d23998655abd95398c48bf7c9a83f48f860eff77:"
        },
        {
          "resource": "repo://sources/estate/arb-pay-reg-2026q3-payments-arb-adr-register-and-minutes.md#L46-L48",
          "version": "repo-lines-v1:sha256:a5c7b1831280e0be95eaac6d86f371d80ddfd28ddf6297df060b38da2c6396b5:"
        }
      ]
    },
    {
      "id": "claim_86315976702d4d6ab53ac750373d3ec1",
      "statement": "ADR-PAY-026 requires each client-facing insight to receive MRM classification (as a Model or as an End-User Analytic) before it goes to production.",
      "evidence": [
        {
          "resource": "repo://sources/estate/arb-pay-reg-2026q3-payments-arb-adr-register-and-minutes.md#L46-L48",
          "version": "repo-lines-v1:sha256:a5c7b1831280e0be95eaac6d86f371d80ddfd28ddf6297df060b38da2c6396b5:"
        }
      ]
    },
    {
      "id": "claim_66fcf79700a346b1b9f25f05f8646878",
      "statement": "TDIP's Insights API computes client-facing analytical outputs in TDIP (batch or micro-batch), publishes them to a low-latency serving store, and exposes them through versioned endpoints with entitlement checks delegated to the calling channel.",
      "evidence": [
        {
          "resource": "repo://sources/estate/tdip-cat-2026.2-treasury-data-and-insights-platform-data-catalog-extract.md#L71-L73",
          "version": "repo-lines-v1:sha256:627406a5f38f3a903386344fcdf05641c3099de97b8fac82a95d87a2c3e87c76:"
        }
      ]
    },
    {
      "id": "claim_5d84d78834c945bbbece5ee6f2f1c4fe",
      "statement": "The reference Insights API endpoint is EP-TDIP-01, GET /tdip/insights/v1/cash-forecast/{clientId}, GA since 2025-09, backed by model M-TRS-0142, with p95 latency 120 ms; no Insights API endpoints exist yet for wire-history or corridor insights, and the related feature table client_wire_history_features is an unproductionized prototype with no MRM registration.",
      "evidence": [
        {
          "resource": "repo://sources/estate/tdip-cat-2026.2-treasury-data-and-insights-platform-data-catalog-extract.md#L46-L47",
          "version": "repo-lines-v1:sha256:6200b3a7e26c527b6a51971f818d401befff951df3318dc156ea4f113cadcc28:"
        },
        {
          "resource": "repo://sources/estate/tdip-cat-2026.2-treasury-data-and-insights-platform-data-catalog-extract.md#L75-L78",
          "version": "repo-lines-v1:sha256:6a6b1196659c581618e2f4785c778ab87483b3e978dbabe9afb2ebf3b9d88b0a:"
        }
      ]
    },
    {
      "id": "claim_2942fca389a240eeb69167ed1b546e12",
      "statement": "Onboarding a new TDIP insight follows a four-step process: MRM inventory registration per MRM-POL-02, data access approvals per DUS-07, building the serving endpoint (roughly 13-21 story points typical), and Disclosure Review Committee approval of client-facing wording and disclaimers.",
      "evidence": [
        {
          "resource": "repo://sources/estate/tdip-cat-2026.2-treasury-data-and-insights-platform-data-catalog-extract.md#L80-L80",
          "version": "repo-lines-v1:sha256:a8e6adad988dc571ad903be21a8e008015faa8deba0e7214b8154065589d6517:"
        }
      ]
    },
    {
      "id": "claim_54b5f98c08f64b1ca8443771de9ea8cf",
      "statement": "Under MRM-POL-02 v7.0, any customer-facing estimate (a forward-looking value shown to a client) is classified Tier 2 at minimum and cannot be shown to clients until independent validation and approved use conditions (disclaimers, monitoring thresholds) are complete, while an End-User Analytic (simple descriptive calculation with no forward-looking estimation) requires only registration and business-owner attestation.",
      "evidence": [
        {
          "resource": "repo://sources/estate/mrm-pol-02-v7.0-model-risk-management-policy-extract.md#L29-L42",
          "version": "repo-lines-v1:sha256:fd8a9cf07e953cb92c84f0ce764a38239230bf40e684002966d739166cbd941a:"
        }
      ]
    },
    {
      "id": "claim_fdaf2f8c5f844b19805b43eabe49a857",
      "statement": "MRM-POL-02 Tier 2 validation is typically 10-14 weeks (160-240 validator hours), and as of Q4-2026 the Tier 2 validation queue has roughly a 6-week wait before work starts.",
      "evidence": [
        {
          "resource": "repo://sources/estate/mrm-pol-02-v7.0-model-risk-management-policy-extract.md#L38-L38",
          "version": "repo-lines-v1:sha256:7b42f978464bdf3ca26cbfb2b37bb36ba8948880b94e5649921a0dddc75331ed:"
        },
        {
          "resource": "repo://sources/estate/mrm-pol-02-v7.0-model-risk-management-policy-extract.md#L68-L70",
          "version": "repo-lines-v1:sha256:6bcb6ea7791f1bc1f58101ac8d9abf78e4eb84359ab131e327edb160611baec0:"
        }
      ]
    },
    {
      "id": "claim_6ab3f1c706ed4d848675bf52d6a8f35f",
      "statement": "Financial-crimes Tier 1 models and features, including Sentinel fraud scores (M-FCT-0021) and beneficiary mule-risk features (M-FCT-0034), may not be used for product, marketing, or client-facing purposes.",
      "evidence": [
        {
          "resource": "repo://sources/estate/mrm-pol-02-v7.0-model-risk-management-policy-extract.md#L46-L46",
          "version": "repo-lines-v1:sha256:2ab196be7cadf232c6602cd6a8ce392cfa24f43020f3931a8c5426bc2b671e4e:"
        }
      ]
    },
    {
      "id": "claim_1aa96db4e226401bb29ef3ea78c1c5ae",
      "statement": "Under the Data Use & Client Confidentiality Standard (DUS-07), a client's own historical transactions may be used to generate insights shown to that client only when based on at least 5 comparable transactions with the count and period stated as the basis.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L72-L72",
          "version": "repo-lines-v1:sha256:e6c5dbd37a2eb00b399d040ed8ef244a0702b517812db82aca59034b939b4878:"
        }
      ]
    },
    {
      "id": "claim_3fe589a0ec5c4010a0d0683f3c36e883",
      "statement": "Under DUS-07, aggregated cohort statistics drawn from multiple clients may be shown to clients only if the cohort has at least 500 transactions, at least 20 distinct originating clients, no single client contributing more than 15% of cohort volume, at least monthly refresh, and Disclosure Review Committee approval of wording and disclaimers; cohorts failing any condition must be suppressed rather than rounded or approximated.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L46-L60",
          "version": "repo-lines-v1:sha256:b947da52469af808271803afaf573c53290020b53d6fda6fc78b9d28d4dc089f:"
        }
      ]
    },
    {
      "id": "claim_0ff9be37085c4a9f94f089e5569b245a",
      "statement": "The CBO Wire Center BFF (cbo-wire-bff) does not currently integrate with the TDIP Insights API; its only backend integrations are PPH v1 APIs, CES entitlements, CBO Auth step-up, and ENS notifications.",
