    },
    {
      "id": "claim_58b4347084694e7fb8670e646d0c2d44",
      "statement": "pay_wire_txn_hist.uetr is populated only for Swift wires from 2018 onward and for Fedwire wires from 2025-10 onward (per ADR-PAY-023), so any UETR-based join to gpi_tracker_events is unreliable for Fedwire wires released before 2025-10.",
