    {
      "id": "claim_2055f3e197124a428e910d1fa2a8830d",
      "statement": "gpi statuses handled include ACSP/G000 (forwarded to next gpi agent, further updates expected), ACSP/G001 (forwarded to non-gpi agent, tracking ends), ACSP/G002-G004 (pending states, update expected), ACCC (terminal, credited with confirmed amount and credit timestamp), and RJCT plus reason code (terminal, return expected via pacs.004).",
      "evidence": [
