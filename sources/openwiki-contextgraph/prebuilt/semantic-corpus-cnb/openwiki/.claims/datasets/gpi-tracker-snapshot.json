  "claims": [
    {
      "id": "claim_5cfb42f059b0496cad06b459f9f650e7",
      "statement": "GPI_TRACKER_SNAPSHOT is an Oracle table owned and written exclusively by the Swift Alliance & gpi Connector (GPI-C) module of the Payment Network Gateway, and is the single source of Swift gpi tracking status in the estate.",
      "evidence": [
        {
          "resource": "repo://sources/estate/png-tdd-6.0-payment-network-gateway-fedwire-and-gpi-technical-design.md#L57-L88",
          "version": "repo-lines-v1:sha256:4ff7cdbb54745e38b1c6f96d14227eec8bf164bffcf6cc732f17015c60ffac39:"
        }
      ]
    },
    {
      "id": "claim_53d310d0b26b4d62a96457656f080120",
      "statement": "GPI-C retrieves gpi Tracker updates via the Swift API through the Swift Microgateway using SwiftNet PKI credentials bound to the GPI-C service account, in a batch integration that runs every 4 hours (00:00, 04:00, 08:00, 12:00, 16:00, 20:00 ET), requesting changed transactions for outbound UETRs from the last 30 days and upserting results into GPI_TRACKER_SNAPSHOT.",
      "evidence": [
        {
          "resource": "repo://sources/estate/png-tdd-6.0-payment-network-gateway-fedwire-and-gpi-technical-design.md#L75-L78",
          "version": "repo-lines-v1:sha256:84b7ff134cc14e434c860339735bc03145120e7504082b60c6ff112c36177c41:"
        }
      ]
    },
    {
      "id": "claim_ed4528c9e7114905a67775482a88a6ff",
      "statement": "GPI_TRACKER_SNAPSHOT has columns UETR (join key to PPH v2 identifiers.uetr), LAST_STATUS/LAST_REASON (ACSP/ACCC/RJCT with G000-G004 or ISO reject reason), ROUTE_JSON (ordered agents with BIC, name, country, received/forwarded timestamps), DEDUCTED_CHARGES_JSON (per-agent charges when reported), CONFIRMED_AMOUNT/CREDIT_TS (populated with ACCC), and SNAPSHOT_TS (time GPI-C captured the update).",
      "evidence": [
        {
          "resource": "repo://sources/estate/png-tdd-6.0-payment-network-gateway-fedwire-and-gpi-technical-design.md#L79-L86",
          "version": "repo-lines-v1:sha256:e3d8402b36ed8a89b19995d5a7cc508d7fbdbf26e12496a408a3b5078815b5aa:"
        }
      ]
    },
    {
