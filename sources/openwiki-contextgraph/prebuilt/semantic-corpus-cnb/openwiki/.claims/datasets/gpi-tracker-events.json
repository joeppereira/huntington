    {
      "id": "claim_b15727aed351472e96eca0fdbbf33abb",
      "statement": "gpi_tracker_events mirrors the GPI_TRACKER_SNAPSHOT schema: UETR (join key to PPH v2 identifiers.uetr), LAST_STATUS/LAST_REASON (ACSP/ACCC/RJCT plus G000-G004 gpi reason codes or an ISO reject reason), ROUTE_JSON (ordered agent chain), DEDUCTED_CHARGES_JSON (per-agent deducted charges), CONFIRMED_AMOUNT/CREDIT_TS (reported with ACCC), and SNAPSHOT_TS (GPI-C capture time).",
      "evidence": [
        {
          "resource": "repo://sources/estate/png-tdd-6.0-payment-network-gateway-fedwire-and-gpi-technical-design.md#L79-L104",
          "version": "repo-lines-v1:sha256:debc4c9dc31556ad09184c02f19bfc8b8d623e2c67de7eb06b93459f73dde539:"
        }
      ]
    },
