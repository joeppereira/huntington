    {
      "id": "claim_f1e788babc3d4111bc6e901fd6a25717",
      "statement": "GPI_TRACKER_SNAPSHOT is populated by the Swift Alliance & gpi Connector (GPI-C), which polls the Swift Tracker API via the Swift Microgateway every 4 hours for changed outbound-UETR transactions from the last 30 days and upserts results into the Oracle table; TDIP's gpi_tracker_events dataset is a downstream nightly (soon hourly) copy of that table, so its freshness is bounded by GPI-C's 4-hour capture cadence plus the TDIP load interval.",
      "evidence": [
        {
          "resource": "repo://sources/estate/png-tdd-6.0-payment-network-gateway-fedwire-and-gpi-technical-design.md#L75-L88",
