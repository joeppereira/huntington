    {
      "id": "claim_296e7b99aa6941fc866fad12e61aa53b",
      "statement": "DUS-07 Section 6 permits using a client's own historical transactions to generate insights shown to that client, giving as its own example 'the typical time for that client's past wires to a given beneficiary to complete,' subject to a minimum of 5 comparable transactions and disclosure of count and period - a materially lighter compliance bar than DUS-07 Section 5's cross-client cohort aggregation thresholds (500+ transactions, 20+ distinct originating clients, no client over 15% of volume, monthly refresh, DRC-approved wording) that would apply to a cross-client table such as wire_corridor_stats_daily.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L46-L60",
          "version": "repo-lines-v1:sha256:b947da52469af808271803afaf573c53290020b53d6fda6fc78b9d28d4dc089f:"
        },
        {
