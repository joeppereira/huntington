    {
      "id": "claim_f59a5d7b53a34e2d9a0366454aa3fcad",
      "statement": "MRM-POL-02 v7.0 re-baselines to the April 17, 2026 interagency guidance (SR 26-2; OCC Bulletin 2026-13; FDIC FIL-15-2026) replacing SR 11-7, introducing a complexity-based model definition, a formal End-User Analytic (EUA) category, purpose/exposure-based risk tiering, and a dedicated vendor-models section.",
      "evidence": [
        {
          "resource": "repo://sources/estate/mrm-pol-02-v7.0-model-risk-management-policy-extract.md#L15-L27",
          "version": "repo-lines-v1:sha256:0d13397add156834f609d8e9c5844dff3d56a4cc90e551c533c73b2c10175706:"
        }
      ]
    },
    {
      "id": "claim_fa4b1ef94d264bef97550ba0edb52605",
      "statement": "MRM-POL-02 defines a Model as a quantitative method of meaningful complexity producing decision-relevant or client-communicated estimates/predictions, an EUA as a simple descriptive calculation with no forward-looking estimation needing only Archer registration and business-owner attestation, and a customer-facing estimate as any forward-looking value shown to a client that is Tier 2 at minimum.",
      "evidence": [
        {
          "resource": "repo://sources/estate/mrm-pol-02-v7.0-model-risk-management-policy-extract.md#L29-L43",
          "version": "repo-lines-v1:sha256:866add96d4fa1d63f100e0b2a30d78ba491691548720e8cb107f7aed0baee50b:"
        }
      ]
    },
    {
      "id": "claim_1700bd3560a945c59bf88e27f7d77762",
      "statement": "MRM-POL-02 defines four tiers with validation lead times: Tier 1 (regulatory/capital/financial-crimes/high exposure) requires full independent validation with annual review; Tier 2 (customer-facing or client-decision-influencing) requires independent validation typically 10-14 weeks and 160-240 validator hours; Tier 3 (internal operational, limited exposure) requires targeted validation in 6-9 weeks; EUA requires registration plus attestation in about 2 weeks.",
      "evidence": [
        {
          "resource": "repo://sources/estate/mrm-pol-02-v7.0-model-risk-management-policy-extract.md#L36-L43",
          "version": "repo-lines-v1:sha256:f8b9027402087c4f37afc8791d0d71bd18c88d7c9da98ad2cce61ad3076c3f0c:"
        }
      ]
    },
    {
      "id": "claim_67824a3aa1f843faa1e282d6574a52fa",
      "statement": "MRM-POL-02 prohibits use of Tier 1 financial-crimes model outputs, including the Sentinel payment fraud score (M-FCT-0021) and beneficiary mule-risk features (M-FCT-0034), for product, marketing, or client-facing purposes, and requires compensating controls and outcome monitoring for vendor models when the vendor cannot provide sufficient development information.",
      "evidence": [
        {
          "resource": "repo://sources/estate/mrm-pol-02-v7.0-model-risk-management-policy-extract.md#L44-L49",
          "version": "repo-lines-v1:sha256:a560a8f123796edc68b38b0306d1cae2aa10a92cf7cc10a5411b9f744bc4a6b2:"
        }
      ]
    },
