    {
      "id": "claim_9409779f09bd400885c8060848e8679d",
      "statement": "DUS-07 purpose limitation requires that data derived for one purpose (e.g., fraud detection, AML, credit) not be reused for another purpose without Privacy Office approval (plus FCC approval for financial-crimes data), and feature tables inherit the most restrictive permitted purpose among their inputs.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L38-L40",
          "version": "repo-lines-v1:sha256:3aaddc7c397555a338a34b6ce226481dfe6f1ec0617e50f9b12bd7338bf99880:"
        }
      ]
    },
    {
      "id": "claim_8ca482c6d3894afcad51a2bdb340752d",
      "statement": "DUS-07 cross-client confidentiality prohibits using information about one client, including its behavior as a transaction counterparty, to generate content shown to another client, even when presented as an abstracted pattern or insight and even if the counterparty is unnamed.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L42-L44",
          "version": "repo-lines-v1:sha256:44f7824b941688d5f85ce2d547a0511eba13b594fd82035be0155bafc25e0643:"
        }
      ]
    },
    {
      "id": "claim_d2c4e1acca8b4a4891780dafe35bca71",
      "statement": "Aggregated cohort statistics may be shown to clients only if the cohort has at least 500 transactions, at least 20 distinct originating clients, no single client contributing more than 15% of volume, monthly-or-more-frequent refresh, and DRC-approved wording; cohorts failing any condition must be suppressed rather than rounded or approximated.",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L46-L60",
          "version": "repo-lines-v1:sha256:b947da52469af808271803afaf573c53290020b53d6fda6fc78b9d28d4dc089f:"
        }
      ]
    },
    {
      "id": "claim_d4321b4055674bf1a73760ec32bbccde",
      "statement": "A client's own historical data may be used to generate insights shown back to that same client only if based on at least 5 comparable transactions, with the insight disclosing its basis (count and period).",
      "evidence": [
        {
          "resource": "repo://sources/estate/dus-07-v2.1-data-use-and-client-confidentiality-standard.md#L62-L72",
