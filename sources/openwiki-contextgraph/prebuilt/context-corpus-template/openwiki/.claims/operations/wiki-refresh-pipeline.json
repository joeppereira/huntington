    {
      "id": "claim_927dadf944cd46ab830d1484db9061c7",
      "statement": "The workflow re-raises failure after PR creation: a final step exits with status 1 if steps.openwiki.outcome == 'failure', so the overall GitHub Actions run is marked failed (surfacing the problem) even though partial progress was already committed to the PR branch.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L86-L88",
          "version": "repo-lines-v1:sha256:fd6f0cbd8d9f20e4111509ed1d7e17265ef0726a5b025ee59f6b717d085a3a96:"
