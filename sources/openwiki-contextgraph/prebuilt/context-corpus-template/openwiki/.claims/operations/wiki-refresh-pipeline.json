  "claims": [
    {
      "id": "claim_5983f2d203f04604959e0ee067afb78d",
      "statement": "The GitHub Actions workflow .github/workflows/openwiki-update.yml regenerates the repository's OpenWiki context graph by running `openwiki code --update --print`, triggered both on a daily schedule (cron \"0 8 * * *\") and manually via workflow_dispatch.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L1-L6",
          "version": "repo-lines-v1:sha256:16ba04e9202569837ade828e4d9db95a857b406498fe322c003dec93962ae7ec:"
        },
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L33-L36",
          "version": "repo-lines-v1:sha256:d58ef5f498c02b45776d67452c92ddb307313815a56beddaf62b0c62e897fa58:"
        }
      ]
    },
    {
      "id": "claim_58cd686e34e847fbbb52f302934c51e9",
      "statement": "The workflow checks out the repository with fetch-depth: 0 (full git history) because `openwiki code --update` diffs the current HEAD against the previously documented commit; a shallow clone would hide that commit and cause the update to see an empty change summary.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L16-L22",
          "version": "repo-lines-v1:sha256:5f513af748b362994b00e41cc2ab8ac7880f4f9a4ac3fb63f49be6f3f2680e8b:"
        }
      ]
    },
    {
      "id": "claim_00c3bf4d4f284bd8a655a7a68fedeedb",
      "statement": "The `openwiki` step runs with continue-on-error: true and id: openwiki, allowing later steps (cleanup, PR creation, failure propagation) to execute and to branch on steps.openwiki.outcome even when the OpenWiki run itself fails.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L33-L36",
          "version": "repo-lines-v1:sha256:d58ef5f498c02b45776d67452c92ddb307313815a56beddaf62b0c62e897fa58:"
        },
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L86-L88",
          "version": "repo-lines-v1:sha256:fd6f0cbd8d9f20e4111509ed1d7e17265ef0726a5b025ee59f6b717d085a3a96:"
        }
      ]
    },
    {
      "id": "claim_523e0233c7cd46548c8992c962a45df7",
      "statement": "The workflow deletes the transient run-state file openwiki/.run.json after the openwiki step, guarded by if: !cancelled(), so it is never committed or included in the pull request.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L50-L52",
          "version": "repo-lines-v1:sha256:9a839067f47beb1ca08c710b71e598b0402cc1fd184fbaffb0641be925ef8a7a:"
        }
      ]
    },
    {
      "id": "claim_8b640b4531e44dd489fbe57730fdb57a",
      "statement": "The workflow stages only a fixed set of paths for the automated pull request — openwiki, AGENTS.md, and .github/workflows/openwiki-update.yml, plus CLAUDE.md only if that file exists — so any other working-tree changes after the run are not included in the PR.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L54-L69",
          "version": "repo-lines-v1:sha256:6b20dee24ff01dbab809560852a5eb32298fc43f8d7b298784f7d92d4552e278:"
        }
      ]
    },
    {
      "id": "claim_36e4d92bfd934c09a1a7131703c9b3d7",
      "statement": "The pull request is created via peter-evans/create-pull-request on branch openwiki/update (commit message and title both 'docs: update OpenWiki') whenever the job was not cancelled, i.e. even after the openwiki step failed, so a failed run still produces a PR containing whatever pages completed before the failure.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L64-L84",
          "version": "repo-lines-v1:sha256:4e19c91fe00b7b0a0a3f068c4a74b6f0d5b7eccb70d7258f4ef02dc707a245b3:"
        }
      ]
    },
    {
      "id": "claim_a216ef3343524cb09f9f27291ca0ebc8",
      "statement": "The PR body embeds the openwiki step's outcome and documents that, on failure, the PR intentionally preserves only pages completed before the failure and that merging it establishes that partial progress as the baseline for the next scheduled run.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L73-L80",
          "version": "repo-lines-v1:sha256:0f10276dfdd170fda11d4a1f25f215ddc0499e2966eb628a3e975dcac7aa7dc9:"
