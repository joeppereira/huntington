    {
      "id": "claim_eb10ee142031402ab077611ad39b13eb",
      "statement": "CCB FY2025 growth was driven by higher Card net interest income and card spend, partly offset by deposit margin compression; noninterest expense grew 2.9% versus revenue 4.7%, and provision rose 10.2% to $5.96B.",
      "evidence": [
