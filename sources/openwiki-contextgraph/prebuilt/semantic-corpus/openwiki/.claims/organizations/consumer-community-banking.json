    {
      "id": "claim_3ef3f574ce7848faa0b2cede36531d67",
      "statement": "In FY2025 CCB produced $40.8B of net revenue and $12.3B of net income (6.8% growth), roughly half of Firm net income of $24.96B, with a 30% ROE on $40.0B of average allocated equity versus 21% for the Firm; segment capital is allocated on standalone risk profile including Standardized requirements, stress capital buffer and G-SIB surcharge.",
      "evidence": [
        {
          "resource": "repo://sources/reports/mhfc-2025-annual-report.md#L166-L176",
          "version": "repo-lines-v1:sha256:54fbf19c21b0be120f07a08cd92f37bd296da3a739b0b5cb5c0a469402ba962b:"
