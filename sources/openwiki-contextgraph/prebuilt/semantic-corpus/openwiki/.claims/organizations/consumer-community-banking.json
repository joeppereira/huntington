    {
      "id": "claim_221cccd8e4de45ddaac3d34d73109071",
      "statement": "CCB is one of three reportable segments of Meridian Harbor (with CIB and AWM, plus a Corporate segment) and offers deposit, investment, lending and payments products to consumers and small businesses through Banking & Wealth Management, Home Lending, Card Services and Auto, serving 74 million customers via 4,180 branches, 15,900 ATMs and digital channels.",
      "evidence": [
        {
          "resource": "repo://sources/reports/mhfc-2025-annual-report.md#L180-L180",
          "version": "repo-lines-v1:sha256:be95c03ea668900a22b7d718355d053ac9ba3d59e954cce3eca82338ea1fa1a1:"
