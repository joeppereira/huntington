    },
    {
      "id": "claim_f627917316e04f8eb3827d7d7884d9f7",
      "statement": "API-07 performs identity verification, customer due diligence and beneficial-ownership checks and returns a KYC status and AML risk rating used to gate account opening and payment limits.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-07-customer-identity-kyc-api.md#L4-L4",
          "version": "repo-lines-v1:sha256:fa15f0e172fae9f476f5d17424578ba25d981e3d7cbd32b7a8f5c84e323cd62d:"
        }
      ]
    },
    {
      "id": "claim_5e723368925e47418c8115c75e6ca754",
      "statement": "API-07 documents three endpoints: POST /verifications to start an individual or entity verification, GET /verifications/{id} returning verified, review or rejected with reason codes, and GET /customers/{customerId}/risk-rating returning low, medium or high.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-07-customer-identity-kyc-api.md#L19-L25",
          "version": "repo-lines-v1:sha256:42c854aacb3a636f98ee217f1035596976c7e561957b2c6970e625771a2e4a7e:"
        }
      ]
    },
    {
      "id": "claim_e40894ad659649669a97b0c77ff49824",
      "statement": "The team's operating commitments for API-07 are Restricted - PII classification, OAuth scopes kyc:verify and kyc:read, a rate limit of 200 requests/minute per client, and an SLO of 99.9% availability with p95 verification latency of 1.2 s.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-07-customer-identity-kyc-api.md#L14-L17",
          "version": "repo-lines-v1:sha256:3812ec49db556d6558b9ec1f7a380d836137fc5582b8c0a4d5df03622f15759e:"
        }
