    },
    {
      "id": "claim_e46451f5b2b347c2907bc405aebcd61c",
      "statement": "API-04's 99.99% availability and p95 4 s objective is measured end-to-end, whereas API-03's p95 of 400 ms is a plain latency target and API-05 states no latency target. API-05's 99.99% availability applies only during operating hours.",
      "evidence": [
        {
