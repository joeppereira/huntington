    {
      "id": "claim_249e817c39254220bad60496f5d594b9",
      "statement": "API-03 is a staged payment flow: payments move through received, screened, released, settled and returned. Every payment is screened by sanctions and the Fraud Risk Signals API before release, and cancellation via POST /payments/{paymentId}/cancel is only possible before release.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-03-payments-initiation-api.md#L4-L26",
          "version": "repo-lines-v1:sha256:7a360f06ac2891302b0448033df30ed5307298a07163d9881f67244d0f978336:"
        }
      ]
    },
    {
      "id": "claim_43127b89ac14410e88d04cbe76708580",
      "statement": "API-03 accepts bulk payment files (ISO 20022 pain.001 or CSV) through POST /payment-files under a dedicated payments.bulk:write scope, with files of up to 50,000 items, in addition to single payments created with an Idempotency-Key.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-03-payments-initiation-api.md#L6-L26",
          "version": "repo-lines-v1:sha256:3cecf950eb2a659c5a45e8ed8742173d5e2d130d87e07b3600fe31a76f2d94c0:"
        }
      ]
    },
    {
      "id": "claim_6f88b10fe260424a804f7799bf3b4ef0",
      "statement": "API-04 sends instant, irrevocable credit transfers and requests for payment 24x7x365, caps each payment at $1,000,000, reports status as accepted, rejected or pending-review, and offers GET /participants/{routing} to check whether a receiving bank is reachable on the network.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-04-real-time-payments-api.md#L4-L26",
          "version": "repo-lines-v1:sha256:0613116b72bb54a26c653abfb945e2e0df6ae5aa6d00ae01537282db0b83d356:"
        }
