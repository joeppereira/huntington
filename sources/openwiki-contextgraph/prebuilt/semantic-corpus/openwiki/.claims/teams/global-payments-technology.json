    {
      "id": "claim_2cc19b2378dc4f818a19b0e30d08d392",
      "statement": "Global Payments Technology is the named owning team of exactly three Payments-domain APIs: API-03 Payments Initiation (v3.2, /payments/v3), API-04 Real-Time Payments (v2.3, /rtp/v2) and API-05 Wire Transfer (v2.0, /wires/v2), all classified Restricted - Financial Transaction.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-03-payments-initiation-api.md#L6-L17",
          "version": "repo-lines-v1:sha256:99b788ef36ab25d8dcbf41563cbc2b091358cf170480d9e0b70bd64c1e32f6d3:"
