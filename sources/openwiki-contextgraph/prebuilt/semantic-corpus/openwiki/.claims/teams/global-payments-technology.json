    {
      "id": "claim_71e395061e904ef7a819bdc0b50ec426",
      "statement": "API-05 handles cross-currency wires in two steps: the client calls POST /wires/quotes for an FX quote valid for 60 seconds, then submits the wire with the returned quoteId. The wire starts in a screening status, is tracked by UETR, and goes out over Fedwire (domestic) or SWIFT (MT or ISO 20022 MX).",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-05-wire-transfer-api.md#L4-L65",
