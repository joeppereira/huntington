    {
      "id": "claim_d125ad42ef394a878aaf79ff2d1512f3",
      "statement": "API-02 provides posted and pending transactions with merchant enrichment for deposit and card accounts, up to 24 months of history, via two GET endpoints and a POST /transactions/search; merchant.location was added in v3.1 and enrichment reached GA in v3.0.",
