    {
      "id": "claim_12033c3dfea24640944b6e3e5b04ed78",
      "statement": "API-01 exposes four read-only GET endpoints (account list, detail, balances, holders). Balances return current, available and ledger values with an as-of timestamp and, since v3.4, a holds field; holders are returned with masked PII.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-01-accounts-api.md#L19-L66",
