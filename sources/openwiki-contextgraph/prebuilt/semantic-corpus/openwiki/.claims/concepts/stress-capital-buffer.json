    {
      "id": "claim_225b0615f1294f7fa399b45689a9466d",
      "statement": "The indicative SCB is not binding. The regulatory requirement uses the Fed-set SCB input (Assumptions B19, 3.2%, giving 10.20%) while the indicative SCB only produces a comparison requirement (10.18%). The stress pass/fail test compares the minimum stressed ratio with the current-SCB requirement and outputs YES or 'NO - capital action required'.",
      "evidence": [
        {
          "resource": "repo://sources/models/capital-planning-model.md#L116-L141",
          "version": "repo-lines-v1:sha256:c278667fda61c7a76735da0af9382a1e3b48f82d86515f812b810cbbbd0ff384:"
