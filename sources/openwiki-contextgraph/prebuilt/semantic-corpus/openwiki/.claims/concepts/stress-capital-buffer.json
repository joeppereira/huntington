    {
      "id": "claim_961dde3570794bcdad298e659bdd54a1",
      "statement": "The Standardized CET1 requirement is 10.2%, the sum of the 4.5% regulatory minimum, a 3.2% stress capital buffer (effective 2025-10-01) and a 2.5% G-SIB surcharge, with the countercyclical buffer at 0%. Management targets about 13.0% above it.",
      "evidence": [
        {
          "resource": "repo://sources/models/capital-planning-model.md#L116-L141",
          "version": "repo-lines-v1:sha256:c278667fda61c7a76735da0af9382a1e3b48f82d86515f812b810cbbbd0ff384:"
