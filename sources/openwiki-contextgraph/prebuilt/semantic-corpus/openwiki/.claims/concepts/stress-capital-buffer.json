    {
      "id": "claim_fad3c491948a42cca4a14ec6369be3cd",
      "statement": "MDL-CAP-003 computes the indicative SCB as MAX(2.5%, (starting CET1 ratio minus minimum severely adverse CET1 ratio) + (four quarters of baseline common dividends / starting RWA)). For the Q2 2026 start this gives 2.24% + 0.94% = 3.18%, and the 2.5% floor is not binding.",
      "evidence": [
        {
          "resource": "repo://sources/models/capital-planning-model.md#L35-L41",
