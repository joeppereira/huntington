    {
      "id": "claim_8b4fa2fa62b84a63b2b427985a3511ab",
      "statement": "The model's inputs are starting CET1 and RWA from API-16, scenario paths from API-14, liquidity cross-checks from API-15 and a Board Capital Committee-approved distribution plan. Its outputs feed the Annual Report capital risk section and the Pillar 3 capital planning and stress testing section.",
      "evidence": [
        {
