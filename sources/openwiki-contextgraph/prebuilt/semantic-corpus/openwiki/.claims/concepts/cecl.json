          "version": "repo-lines-v1:sha256:9a974c85d172485a3d62b1909dc21c3b47cd957f9a4f8826007c09b03b77e537:"
        }
      ]
    },
    {
      "id": "claim_69ea86b416824b67bdddc91168cfc556",
      "statement": "The provision for credit losses equals net charge-offs plus the net allowance change: 2025 was $6,840 million (net charge-offs of $6,100 million plus a $740 million build, mainly Card) and Q2 2026 was $1,920 million ($1,650 million plus a $270 million build). The 2025 and quarterly allowance roll-forwards reconcile as opening balance minus net charge-offs plus provision.",
      "evidence": [
        {
          "resource": "repo://sources/reports/mhfc-2025-annual-report.md#L144-L146",
          "version": "repo-lines-v1:sha256:af5292f5bcf5d4f1aaea11795cb3650422ece49f3fd1899897761290626897ab:"
        },
        {
          "resource": "repo://sources/reports/mhfc-2025-annual-report.md#L594-L608",
          "version": "repo-lines-v1:sha256:0a15df5b04d6d9ce99f91f4a29159b5a52ab2fcdeb02d48f4714fb070c49ca0f:"
        },
        {
