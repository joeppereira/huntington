  "claims": [
    {
      "id": "claim_66b1923cb05f42a09f90f99ef28d0f04",
      "statement": "At MHFC, CECL (ASC 326) governs the allowance for credit losses, which is management's estimate of expected credit losses over the remaining expected life of loans. It was $15,920 million (2.14% of $742,300 million of loans) at Dec 31, 2025 and $16,380 million (2.15%) at Jun 30, 2026.",
      "evidence": [
        {
          "resource": "repo://sources/reports/mhfc-2025-annual-report.md#L345-L353",
          "version": "repo-lines-v1:sha256:d98037539837086c2da1802222f37e1f1e7db44dba7d1f336027886171b3d6fd:"
        },
        {
          "resource": "repo://sources/reports/mhfc-2025-annual-report.md#L363-L367",
          "version": "repo-lines-v1:sha256:be8e034f72d0cf95acc1698ac25412d58468cb1d7b88d4f08d3081061f4b4a4b:"
        },
        {
