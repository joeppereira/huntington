          "version": "repo-lines-v1:sha256:7addcc21c681271b1a8b5d5cb9c6d1f353172009ad5fda9e681f7535f680ce83:"
        }
      ]
    },
    {
      "id": "claim_b707746d4abb43bb880d94a8d56a4eb4",
      "statement": "The allowance is measured collectively on a pool basis for loans with similar risk characteristics and individually for collateral-dependent and restructured wholesale loans. The reasonable and supportable forecast period is two years, then loss rates revert to historical averages over 12 months.",
      "evidence": [
        {
          "resource": "repo://sources/reports/mhfc-2025-annual-report.md#L574-L576",
          "version": "repo-lines-v1:sha256:ed3ebb9385eddc71e57b998e7281da6175889e991fc99f8054f54e95c3ac9512:"
        }
      ]
    },
    {
      "id": "claim_61747990b44d41458582d206f52b16c1",
      "statement": "MDL-CR-007 computes segment lifetime loss as EAD × lifetime PD × LGD under upside, baseline and downside scenarios, weights them by Scenario Committee-approved probabilities (20/50/30 at Dec 31, 2025, unchanged at Jun 30, 2026), and then adds a qualitative overlay. Scenario PD scales with unemployment elasticity and LGD with collateral price changes.",
      "evidence": [
        {
          "resource": "repo://sources/models/cecl-allowance-model.md#L146-L152",
          "version": "repo-lines-v1:sha256:85cef9d216827426eb3c470e36f29e8bba78c10a83831cfdca275053a18128ec:"
        },
        {
