        }
      ]
    },
    {
      "id": "claim_2ae98f78c9724c5d88c2d39e142a1154",
      "statement": "The Dec 31, 2025 allowance of $15,920 million is $15,239 million modeled plus a $681 million qualitative overlay, with segment overlays ranging from $(34) million in Auto to $257 million in Credit Card. The model checks that each segment's overlay stays within ±15% of its modeled allowance and reconciles the model total to the reported allowance with zero difference.",
      "evidence": [
