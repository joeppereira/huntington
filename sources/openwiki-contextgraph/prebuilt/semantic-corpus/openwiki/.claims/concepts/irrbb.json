    {
      "id": "claim_a511df08a2f84e58926e44ef2aa64724",
      "statement": "The NII projection applies instantaneous parallel shocks (-200, -100, 0, +100, +200 bp) to a static year-end balance sheet; each line's repricing factor uses bucket midpoints (month 1.5 for 0-3m, month 7.5 for 3-12m) over a 12-month horizon, so positions repricing after 12 months do not affect NII; assets move one-for-one and liabilities by shock times beta.",
      "evidence": [
        {
          "resource": "repo://sources/models/nii-sensitivity-model.md#L262-L274",
