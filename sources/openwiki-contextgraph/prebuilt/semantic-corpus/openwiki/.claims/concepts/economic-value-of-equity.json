  "claims": [
    {
      "id": "claim_b5164dbef8c94a1faba77e078581cb98",
      "statement": "EVE is computed as a sheet within the Tier 1 Net Interest Income Sensitivity Model MDL-ALM-014 (owned by Corporate Treasury ALM, validated by MRGR), not by a standalone model; its Summary sheet feeds the Annual Report and Pillar 3 IRRBB disclosures.",
      "evidence": [
        {
          "resource": "repo://sources/models/nii-sensitivity-model.md#L9-L34",
          "version": "repo-lines-v1:sha256:3c3820a81f7c7d2f46ee49e0a8541b4d3e9a9b67f3c93459e501d20f0e713d33:"
        }
      ]
    },
    {
      "id": "claim_8ea5ece03eda453f8404e6500b5753c1",
      "statement": "The model approximates EVE with first-order modified duration: per-line dollar duration = sign x balance x modified duration / 100 (assets +, liabilities -), line EVE change = -dollar duration x shock / 100, summed across 14 lines and divided by Tier 1 capital; there is no cash-flow revaluation or convexity, so results are linear and symmetric in the shock.",
      "evidence": [
        {
          "resource": "repo://sources/models/nii-sensitivity-model.md#L404-L430",
          "version": "repo-lines-v1:sha256:edbb55b6faa486fc7d88c157a3779e5ce9f95364a79c2fb48fa86984f06b3a69:"
        },
        {
