    {
      "id": "claim_dc4bd346663d4a199ec3863a34092c1f",
      "statement": "The API exposes three endpoints: GET /accounts/{accountId}/statements lists statements by period, GET /documents/{documentId} downloads a document as application/pdf, and PUT /preferences sets paperless preferences; listing returns document metadata (documentId, period, type) that is used to fetch the PDF by documentId.",
      "evidence": [
