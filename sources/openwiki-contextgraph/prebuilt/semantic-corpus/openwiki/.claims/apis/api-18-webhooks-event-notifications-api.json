  "claims": [
    {
      "id": "claim_8be30ed2576a4816bcaeb74c1381d912",
      "statement": "API-18 (Webhooks & Event Notifications API, v1.3) is served at base path /events/v1, owned by Developer Platform Engineering in the Platform domain, and lets clients subscribe to signed event notifications (payment status changes, card controls updated, statement available) delivered via HTTPS webhooks with retries and replay.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-18-webhooks-event-notifications-api.md#L1-L17",
          "version": "repo-lines-v1:sha256:50edfe5100d122faf911bd2336eaf4a99b3cc1b014d6d865aa4ec989b6517112:"
        }
      ]
    },
    {
      "id": "claim_565675c19cb74f248011bd8e222754ef",
      "statement": "API-18 documents three endpoints: POST /subscriptions (create a webhook subscription), GET /events (list recent events for replay) and POST /subscriptions/{id}/test (send a test event); no list, update or delete subscription endpoints are documented.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-18-webhooks-event-notifications-api.md#L19-L25",
          "version": "repo-lines-v1:sha256:64000d7ef4822b8a3040c621595ab79444d12f42be8c4ce389f2de011e71ffe0:"
        }
      ]
    },
    {
      "id": "claim_b4eb743240814947be60e829464b3455",
      "statement": "API-18 uses OAuth scopes events:subscribe and events:read, limits clients to 100 subscription changes per hour, supports delivery up to 10,000 events/second, and targets 99.95% delivery within 60 seconds; data is classified Confidential.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-18-webhooks-event-notifications-api.md#L6-L17",
          "version": "repo-lines-v1:sha256:c5d76bcee21158a6ac90408046f744297edf58fe3b7c65c3a909ecd23b67667a:"
        }
      ]
    },
    {
      "id": "claim_46dd063bae124090af9168a6e6ccf64b",
      "statement": "Creating a subscription takes a url and an events array (for example payment.settled and payment.returned) with an Idempotency-Key header, and returns the subscription id, a whsec_-prefixed secret and status active.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-18-webhooks-event-notifications-api.md#L27-L57",
          "version": "repo-lines-v1:sha256:2c5640fdd73d1405d3b1a429d09f9ad2b05040be079129e19213679ea30ee08d:"
        }
      ]
    },
    {
      "id": "claim_bc5c13067de24622bef2a8910795ae8b",
      "statement": "Platform-wide rules apply to API-18: POST operations that create resources require an Idempotency-Key retained for 24 hours (409 on reuse with a different payload), OAuth 2.0 with 15-minute JWT tokens, a standard error envelope, and cursor-based pagination for list endpoints.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/mhfc-developer-platform-api-reference.md#L29-L75",
          "version": "repo-lines-v1:sha256:3d0b61f5931366eb7ccf2018927644701e6c2a7f5f4e94772add40d8756690eb:"
        }
      ]
    },
