  "claims": [
    {
      "id": "claim_fc9282d148bb4b5dbd05d8cab2f827a9",
      "statement": "The Developer Platform exposes 18 versioned REST APIs serving three audiences: internal applications, external clients and partners, and internal risk and finance processes including Tier 1 models and regulatory reporting.",
