        {
          "resource": "repo://sources/api_docs/mhfc-developer-platform-api-reference.md#L14-L18",
          "version": "repo-lines-v1:sha256:7c1f81a46f393f50bdfb312bf3efc9d6e8c17674bf4653b7855cbe4ec7d47472:"
