    {
      "id": "claim_97a28f15282a4f2b8d4df58bfad0b275",
      "statement": "API-05 Wire Transfer API (v2.0, base path /wires/v2) initiates domestic Fedwire and cross-border SWIFT (MT/ISO 20022 MX) wires with FX conversion using rates from the FX Rates API, and supports payment tracking via UETR; it is owned by Global Payments Technology in the Payments domain.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-05-wire-transfer-api.md#L2-L17",
          "version": "repo-lines-v1:sha256:7fa9f9253b96b6d9fcb652fa32edf8909db3206f4dff1b5077fb49f2b7e01aaa:"
        }
      ]
    },
    {
      "id": "claim_c287e34a779d4889b3b4def75f1a8e97",
      "statement": "The API exposes three endpoints: POST /wires to create a wire, GET /wires/{wireId} for status and UETR tracking events, and POST /wires/quotes for an FX quote valid for 60 seconds for cross-currency wires.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-05-wire-transfer-api.md#L19-L25",
          "version": "repo-lines-v1:sha256:85e80610f224389330f5c3f13a75b3a95754776dc8fab444079b63bf2474ae67:"
        }
      ]
    },
    {
      "id": "claim_a686e21044254ac595b06a349f3a9abc",
      "statement": "Access uses OAuth scopes wires:write and wires:read, is rate limited to 120 requests/minute per client, has a 99.99% availability SLO during operating hours, and handles data classified Restricted - Financial Transaction.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-05-wire-transfer-api.md#L6-L17",
          "version": "repo-lines-v1:sha256:0713b0351c51b0330e05d51e843e1cc29b1769d8183eef5dfb9c59a798104540:"
        }
      ]
    },
    {
      "id": "claim_04431f72289449c9b7940a9e62ebfa3b",
      "statement": "A wire creation request carries debtorAccount, beneficiary (name, IBAN), amount, currency and a quoteId, with an Idempotency-Key header; the example response returns wireId, uetr, an initial status of screening, and the applied rate.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-05-wire-transfer-api.md#L27-L65",
          "version": "repo-lines-v1:sha256:eb535b34b0847ab4cb94321094964071acbb9bd15d7bc8783e1e94925367bc72:"
