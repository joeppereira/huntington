  "claims": [
    {
      "id": "claim_46f686e96d22488490a82451b7551ff3",
      "statement": "API-11 Loan Servicing API (v2.8, base path /loans/v2, owned by Lending Platforms Engineering) provides loan-level balances, schedules, delinquency, remaining contractual life and repricing terms for consumer and wholesale loans, and supports payoff quotes and payment posting. It is classified Confidential - Client Data with a 99.95% availability SLO and a 900 requests/minute limit.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-11-loan-servicing-api.md#L4-L17",
          "version": "repo-lines-v1:sha256:7a67e45358f28d0ddc2ece7d13fe7f5672a6db9b303d993dd0b41ba7d58f77ea:"
        }
      ]
    },
    {
      "id": "claim_7290697646de44b2923b61b048f6f22b",
      "statement": "The API exposes four endpoints: GET /loans/{loanId}, GET /loans/{loanId}/schedule, GET /portfolio/snapshots/{asOf} (month-end snapshot by segment and repricing bucket 0-3m, 3-12m, 1-5y, >5y) and POST /loans/{loanId}/payoff-quotes. It defines three OAuth scopes: loans:read, loans.payments:write and loans.portfolio:read.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-11-loan-servicing-api.md#L15-L26",
          "version": "repo-lines-v1:sha256:4758a6e85d10e3f14e2e90e2128204891c8ffbfcb6876904376c8fd79b83c558:"
        }
      ]
    },
    {
      "id": "claim_344b7658758e472186f07bf7a1ac548c",
      "statement": "The portfolio snapshot response states units (USD millions), segment balance, repricing-bucket shares and delinquency30Plus; the C&I example balance of 172,500 equals the C&I EAD in the CECL model Segment_Inputs sheet.",
