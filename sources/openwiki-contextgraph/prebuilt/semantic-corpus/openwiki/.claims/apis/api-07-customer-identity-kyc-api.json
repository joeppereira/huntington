    {
      "id": "claim_8438b4ce375745e28729675575af4534",
      "statement": "API-07 (v1.9, base path /kyc/v1, Client Onboarding domain, owned by the Know-Your-Customer Platform team) performs identity verification, customer due diligence and beneficial-ownership checks and returns a KYC status and risk rating used to gate account opening and payment limits.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-07-customer-identity-kyc-api.md#L2-L17",
          "version": "repo-lines-v1:sha256:4857d467f32c3458b68ee91661fa042fc4bd39642d5df204231a6ef20734e496:"
        }
      ]
    },
    {
      "id": "claim_f9803b537ded44bb9c6cd31028f30c97",
      "statement": "The API exposes three endpoints: POST /verifications to start an individual or entity verification, GET /verifications/{id} returning verified, review or rejected with reason codes, and GET /customers/{customerId}/risk-rating returning low, medium or high.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-07-customer-identity-kyc-api.md#L19-L25",
          "version": "repo-lines-v1:sha256:42c854aacb3a636f98ee217f1035596976c7e561957b2c6970e625771a2e4a7e:"
        }
      ]
    },
    {
      "id": "claim_f789e49826b944d3822bfa681865dc62",
      "statement": "Access requires OAuth scopes kyc:verify and kyc:read, is limited to 200 requests/minute per client, has a 99.9% availability SLO with p95 verification latency of 1.2 s, and handles data classified Restricted - PII.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/apis/api-07-customer-identity-kyc-api.md#L6-L17",
          "version": "repo-lines-v1:sha256:ff39569c25939caf4f5adb91ca521f33655f0a54ee75a7bc999460c90b5ad96f:"
        }
      ]
    },
    {
      "id": "claim_4bcb1b87ca8148f58a9990d2172c9e84",
      "statement": "A verification request carries an Idempotency-Key header and a body of type, name, dob and an opaque documentToken; the example response returns id, status, riskRating and the list of checks performed (id, sanctions, pep).",
      "evidence": [
