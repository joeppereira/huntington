  "claims": [
    {
      "id": "claim_d9c31070dfbe419689421b949afa259c",
      "statement": "In CECL_Allowance_Model.xlsx (MDL-CR-007), Scenarios supplies weights (B6:B8 = 20/50/30%) and macro paths, Segment_Inputs supplies EAD, remaining life, PD, LGD and sensitivity parameters, ECL_Calc computes scenario-conditional lifetime ECL in three stacked blocks (rows 7-12, 17-22, 27-32), Allowance_Summary weights and adds the overlay and reconciles, and Sensitivity re-runs the totals at 100% single-scenario weights. Inputs originate from API-10 (PD/LGD), API-11 (balances and life) and API-14 (scenarios), but are held in the workbook as pasted inputs.",
      "evidence": [
        {
          "resource": "repo://sources/models/cecl-allowance-model.md#L116-L178",
          "version": "repo-lines-v1:sha256:81224882e4281557f8497dde24d863e5b455747fb674fc6ae0ba099fcc9a512b:"
