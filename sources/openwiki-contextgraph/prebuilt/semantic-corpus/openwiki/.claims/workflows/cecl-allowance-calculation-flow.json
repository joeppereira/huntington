    {
      "id": "claim_416f54843f8741138e1f4a455a516316",
      "statement": "Scenario PD in ECL_Calc column B is MAX(0, base PD*(1+elasticity*(scenario peak unemployment - Scenarios!$B$11)*100)); the anchor Scenarios!B11 = C7 (baseline peak unemployment), so baseline PD is unshifted and changing the baseline row moves the Upside and Downside shifts too. Lifetime PD in column C is 1-(1-scenario PD)^remaining life.",
      "evidence": [
        {
          "resource": "repo://sources/models/cecl-allowance-model.md#L195-L201",
          "version": "repo-lines-v1:sha256:5f021b025eb3538eece28da557cd92fe519a70e3d591e6bb13bb338b437a794f:"
