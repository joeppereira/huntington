  "claims": [
    {
      "id": "claim_ba33ad5c120142fd97e61ee6a4c0adf3",
      "statement": "The EVE sheet of MDL-ALM-014 approximates the change in economic value of equity with a first-order modified-duration calculation: per line, dollar duration = ±balance × modified duration / 100 (assets positive, liabilities negative), and the line EVE change = -dollar duration × shock_bps / 100, summed across the 14 lines. It is linear and symmetric, has no convexity term, and uses book balances as the value proxy.",
      "evidence": [
        {
          "resource": "repo://sources/models/nii-sensitivity-model.md#L36-L42",
          "version": "repo-lines-v1:sha256:a9f6174ce5f2e2e10aac96ce4d5f2c98db3b5b55041cd6029caf07abc3454b80:"
        },
        {
          "resource": "repo://sources/models/nii-sensitivity-model.md#L404-L450",
          "version": "repo-lines-v1:sha256:ad67bc63c493637340a4a65e5536f63edde7e45c772bb569909b160474d4fa22:"
        },
        {
          "resource": "repo://sources/models/nii-sensitivity-model.md#L581-L595",
          "version": "repo-lines-v1:sha256:f35ebaaaa6de8776e0508cf677bbc2512ed01f1591b932a36def04bffc02e13c:"
        }
      ]
    },
    {
      "id": "claim_f4b4d04052454148955de9faa2a1d383",
      "statement": "The EVE calculation uses the shared shock grid (-200, -100, 0, +100, +200 bp) from the Assumptions sheet and per-line balances and modified durations from Balance_Sheet (column K); it does not use the rate betas or repricing-bucket shares that drive the NII projection. Tier 1 capital ($110,620mm, from API-16) is the denominator for the EVE percentage.",
      "evidence": [
        {
          "resource": "repo://sources/models/nii-sensitivity-model.md#L136-L158",
          "version": "repo-lines-v1:sha256:7dbd60d25d7a1f49d30eb1406fd0640a20ad2ed13d4dd95e1947b3c2fed55da1:"
