    {
      "id": "claim_1f33a9c7c74146f5b1afae8f6b3e974b",
      "statement": "The Summary sheet tests EVE against the 15.0% of Tier 1 Board limit with =IF(H<-limit,\"BREACH\",\"Within limit\"), so only EVE declines can breach; all five FY2025 scenarios are within limit, with the worst decline (-2.47% at +200 bp) using roughly 16% of the limit.",
      "evidence": [
        {
