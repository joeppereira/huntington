    {
      "id": "claim_add198ec7d19460c829b8f00c7304e04",
      "statement": "Baseline inputs all come from the Assumptions sheet: starting CET1 $101,200mm and RWA $668,400mm (from API-16), net income $6,600mm growing 0.8% per quarter, preferred dividends $260mm, common dividend $1.15/share, buybacks $3,000mm per quarter at a flat $262 share price, RWA growth 1%/quarter, and other CET1 movements of −$150mm.",
      "evidence": [
        {
          "resource": "repo://sources/models/capital-planning-model.md#L116-L141",
          "version": "repo-lines-v1:sha256:c278667fda61c7a76735da0af9382a1e3b48f82d86515f812b810cbbbd0ff384:"
