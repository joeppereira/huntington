    {
      "id": "claim_d29a0d142fb94013bb1f1ff58d09bee2",
      "statement": "ECL_Calc computes, per segment and scenario, scenario PD = MAX(0, base PD*(1+elasticity*(scenario peak unemployment - baseline unemployment)*100)), lifetime PD = 1-(1-PD)^remaining life, scenario LGD = MIN(1, MAX(0, base LGD*(1-LGD sensitivity*collateral price change))) and lifetime ECL = EAD*lifetime PD*LGD (e.g. ECL_Calc!G7), with scenario totals of 12,434.76 (G13), 13,817.04 (G23) and 19,478.13 (G33) $mm.",
      "evidence": [
        {
          "resource": "repo://sources/models/cecl-allowance-model.md#L146-L152",
