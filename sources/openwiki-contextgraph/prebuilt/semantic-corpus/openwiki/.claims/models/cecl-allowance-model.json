    {
      "id": "claim_d1ba0973fa164f2c856e2b88812ab5ba",
      "statement": "The model consumes three APIs: API-11 Loan Servicing supplies balances (EAD) and remaining life, API-10 Credit Risk Scoring supplies pool-level PD/LGD parameters refreshed quarterly (with macro elasticities added in v3.0), and API-14 Macroeconomic Scenario supplies scenario paths and weights approved by the Scenario Committee; the qualitative overlay and reported allowance are not API-sourced.",
      "evidence": [
        {
          "resource": "repo://sources/api_docs/mhfc-developer-platform-api-reference.md#L1395-L1404",
          "version": "repo-lines-v1:sha256:8571dcec3776c21413e4aa385fb78f6bf4e92fbfe37b7062b6ee2f4953475f7d:"
