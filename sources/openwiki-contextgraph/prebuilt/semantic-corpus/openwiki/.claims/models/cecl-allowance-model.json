    {
      "id": "claim_174d3a07655344dda3b293fd08a6849c",
      "statement": "MDL-CR-007 is a Tier 1 model owned by Consumer & Wholesale Credit Risk - Allowance Methodology, independently validated by MRGR (last validated 2025-11-04, next due 2026-11-30), that estimates the ASC 326 allowance with probability-weighted macro scenarios and PD x LGD x EAD, and is described as a simplified pool-level demonstration whose production counterpart uses loan-level cash flows.",
      "evidence": [
        {
          "resource": "repo://sources/models/cecl-allowance-model.md#L119-L137",
          "version": "repo-lines-v1:sha256:3b6973fafb5b8a9d132ebc11764661b06ec6d82f43e59bc0a83b69de2051e490:"
